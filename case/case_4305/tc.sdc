create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.185 -clock vclk [get_ports sel_1]
set_input_delay 0.176 -clock vclk [get_ports sel_2]
set_input_delay 0.203 -clock vclk [get_ports sel_3]
set_input_delay 0.179 -clock vclk [get_ports sel_4]
set_input_delay 0.047 -clock vclk [get_ports sel_5]
set_input_delay 0.05 -clock vclk [get_ports sel_6]
set_input_delay 0.235 -clock vclk [get_ports sel_7]
set_input_delay 0.098 -clock vclk [get_ports sel_8]
set_input_delay 0.247 -clock vclk [get_ports sel_9]
set_input_delay 0.115 -clock vclk [get_ports sel_10]
