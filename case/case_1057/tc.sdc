set_input_delay 0.11 -clock vclk [get_ports sel_5]
set_input_delay 0.252 -clock vclk [get_ports sel_6]
set_input_delay 0.165 -clock vclk [get_ports sel_7]
set_input_delay 0.045 -clock vclk [get_ports sel_8]
set_input_delay 0.237 -clock vclk [get_ports sel_9]
set_input_delay 0.053 -clock vclk [get_ports sel_10]
set_input_delay 0.264 -clock vclk [get_ports sel_11]
set_input_delay 0.166 -clock vclk [get_ports sel_12]
set_input_delay 0.13 -clock vclk [get_ports sel_13]
