create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.315 -clock vclk [get_ports sel_1]
set_input_delay 0.328 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.166 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.321 -clock vclk [get_ports sel_3]
set_input_delay 0.074 -clock vclk [get_ports sel_4]
set_input_delay 0.042 -clock vclk [get_ports sel_5]
set_input_delay 0.333 -clock vclk [get_ports sel_6]
set_input_delay 0.057 -clock vclk [get_ports sel_7]
set_input_delay 0.042 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.356 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.332 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.169 -clock vclk [get_ports sel_10]
