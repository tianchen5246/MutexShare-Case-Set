create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.148 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.136 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.155 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.168 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.131 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.174 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.148 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.129 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.139 -clock vclk [get_ports sel_4[2]]
