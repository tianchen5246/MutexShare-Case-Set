create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.237 -clock vclk [get_ports sel_1]
set_input_delay 0.236 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.236 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.226 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.253 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.234 -clock vclk [get_ports sel_4]
set_input_delay 0.247 -clock vclk [get_ports sel_5]
set_input_delay 0.25 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.221 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_7]
set_input_delay 0.224 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.231 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.246 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.238 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_10]
set_input_delay 0.237 -clock vclk [get_ports sel_11]
set_input_delay 0.231 -clock vclk [get_ports sel_12]
set_input_delay 0.241 -clock vclk [get_ports sel_13[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_13[1]]
