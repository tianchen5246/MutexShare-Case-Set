create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.226 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.227 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.227 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.256 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.248 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.251 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.255 -clock vclk [get_ports sel_3[1]]
