create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.096 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.1 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.092 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.08 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.058 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.112 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.1 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.062 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.096 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.092 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.12 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_4[2]]
