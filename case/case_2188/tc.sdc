set_input_delay 0.168 -clock vclk [get_ports sel_6]
set_input_delay 0.101 -clock vclk [get_ports sel_7]
set_input_delay 0.132 -clock vclk [get_ports sel_8]
set_input_delay 0.137 -clock vclk [get_ports sel_9]
set_input_delay 0.103 -clock vclk [get_ports sel_10]
set_input_delay 0.143 -clock vclk [get_ports sel_11]
set_input_delay 0.096 -clock vclk [get_ports sel_12]
set_input_delay 0.199 -clock vclk [get_ports sel_13]
set_input_delay 0.157 -clock vclk [get_ports sel_14]
