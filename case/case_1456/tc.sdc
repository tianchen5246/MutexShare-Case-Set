create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.101 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.111 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.098 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.172 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.164 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.072 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.142 -clock vclk [get_ports sel_4]
set_input_delay 0.145 -clock vclk [get_ports sel_5]
set_input_delay 0.12 -clock vclk [get_ports sel_6]
set_input_delay 0.118 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.087 -clock vclk [get_ports sel_8]
set_input_delay 0.132 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.154 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.101 -clock vclk [get_ports sel_10]
