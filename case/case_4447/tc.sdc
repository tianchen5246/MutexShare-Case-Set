create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.316 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.317 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.202 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.334 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.286 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.293 -clock vclk [get_ports sel_4[1]]
