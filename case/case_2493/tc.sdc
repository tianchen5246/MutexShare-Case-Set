create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.132 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.076 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.158 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.16 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.15 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.144 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.062 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.103 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_5[1]]
