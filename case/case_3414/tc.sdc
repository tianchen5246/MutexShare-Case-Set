create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.191 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.065 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.265 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.177 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.13 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.069 -clock vclk [get_ports sel_3[1]]
