create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.318 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.324 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.328 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.313 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.322 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.33 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.319 -clock vclk [get_ports sel_3[1]]
