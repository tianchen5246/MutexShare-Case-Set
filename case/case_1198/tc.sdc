create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.238 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.269 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.32 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.33 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.302 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.324 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.3 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.279 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.254 -clock vclk [get_ports sel_5[1]]
