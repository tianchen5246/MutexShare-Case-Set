create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.379 -clock vclk [get_ports sel_1]
set_input_delay 0.383 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.38 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.379 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.382 -clock vclk [get_ports sel_3]
set_input_delay 0.376 -clock vclk [get_ports sel_4]
set_input_delay 0.373 -clock vclk [get_ports sel_5]
set_input_delay 0.371 -clock vclk [get_ports sel_6]
set_input_delay 0.375 -clock vclk [get_ports sel_7]
