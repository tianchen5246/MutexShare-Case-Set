create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.184 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.224 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.315 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.219 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.278 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.193 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.252 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.2 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.306 -clock vclk [get_ports sel_6[1]]
