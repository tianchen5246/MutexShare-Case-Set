set_input_delay 0.209 -clock vclk [get_ports sel_5]
set_input_delay 0.173 -clock vclk [get_ports sel_6]
set_input_delay 0.203 -clock vclk [get_ports sel_7]
set_input_delay 0.174 -clock vclk [get_ports sel_8]
set_input_delay 0.176 -clock vclk [get_ports sel_9]
set_input_delay 0.256 -clock vclk [get_ports sel_10]
set_input_delay 0.207 -clock vclk [get_ports sel_11]
set_input_delay 0.2 -clock vclk [get_ports sel_12]
set_input_delay 0.257 -clock vclk [get_ports sel_13]
set_input_delay 0.179 -clock vclk [get_ports sel_14]
