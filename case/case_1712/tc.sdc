create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.227 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.28 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.238 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.241 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.248 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.234 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.246 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.239 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.222 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.277 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.218 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.291 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.224 -clock vclk [get_ports sel_5[2]]
