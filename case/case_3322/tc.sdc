create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.167 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.169 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.176 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.186 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.287 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.287 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.201 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.325 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.297 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.135 -clock vclk [get_ports sel_4[2]]
