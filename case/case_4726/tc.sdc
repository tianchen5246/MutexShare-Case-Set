create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.09 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.092 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.095 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.088 -clock vclk [get_ports sel_2]
set_input_delay 0.086 -clock vclk [get_ports sel_3]
set_input_delay 0.087 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.089 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.09 -clock vclk [get_ports sel_5]
set_input_delay 0.09 -clock vclk [get_ports sel_6]
set_input_delay 0.094 -clock vclk [get_ports sel_7]
set_input_delay 0.093 -clock vclk [get_ports sel_8]
set_input_delay 0.086 -clock vclk [get_ports sel_9]
set_input_delay 0.086 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.092 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.091 -clock vclk [get_ports sel_11[0]]
