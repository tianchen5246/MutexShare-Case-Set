set_input_delay 0.292 -clock vclk [get_ports sel_5]
set_input_delay 0.269 -clock vclk [get_ports sel_6]
set_input_delay 0.249 -clock vclk [get_ports sel_7]
set_input_delay 0.329 -clock vclk [get_ports sel_8]
set_input_delay 0.146 -clock vclk [get_ports sel_9]
set_input_delay 0.163 -clock vclk [get_ports sel_10]
set_input_delay 0.143 -clock vclk [get_ports sel_11]
set_input_delay 0.159 -clock vclk [get_ports sel_12]
set_input_delay 0.258 -clock vclk [get_ports sel_13]
