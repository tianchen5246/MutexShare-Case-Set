set_input_delay 0.081 -clock vclk [get_ports sel_5]
set_input_delay 0.229 -clock vclk [get_ports sel_6]
set_input_delay 0.232 -clock vclk [get_ports sel_7]
set_input_delay 0.092 -clock vclk [get_ports sel_8]
set_input_delay 0.228 -clock vclk [get_ports sel_9]
set_input_delay 0.116 -clock vclk [get_ports sel_10]
set_input_delay 0.256 -clock vclk [get_ports sel_11]
set_input_delay 0.149 -clock vclk [get_ports sel_12]
set_input_delay 0.099 -clock vclk [get_ports sel_13]
set_input_delay 0.213 -clock vclk [get_ports sel_14]
