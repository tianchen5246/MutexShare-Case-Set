create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.069 -clock vclk [get_ports sel_1]
set_input_delay 0.076 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.096 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.044 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.049 -clock vclk [get_ports sel_3]
set_input_delay 0.108 -clock vclk [get_ports sel_4]
set_input_delay 0.082 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.045 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.068 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.036 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.096 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.067 -clock vclk [get_ports sel_7]
set_input_delay 0.039 -clock vclk [get_ports sel_8]
