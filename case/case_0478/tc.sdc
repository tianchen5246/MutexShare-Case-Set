create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.16 -clock vclk [get_ports sel_1]
set_input_delay 0.111 -clock vclk [get_ports sel_2]
set_input_delay 0.143 -clock vclk [get_ports sel_3]
set_input_delay 0.132 -clock vclk [get_ports sel_4]
set_input_delay 0.137 -clock vclk [get_ports sel_5]
set_input_delay 0.11 -clock vclk [get_ports sel_6]
set_input_delay 0.128 -clock vclk [get_ports sel_7]
set_input_delay 0.138 -clock vclk [get_ports sel_8]
set_input_delay 0.179 -clock vclk [get_ports sel_9]
set_input_delay 0.112 -clock vclk [get_ports sel_10]
set_input_delay 0.148 -clock vclk [get_ports sel_11]
set_input_delay 0.148 -clock vclk [get_ports sel_12]
