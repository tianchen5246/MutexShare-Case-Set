create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.14 -clock vclk [get_ports sel_1]
set_input_delay 0.18 -clock vclk [get_ports sel_2]
set_input_delay 0.114 -clock vclk [get_ports sel_3]
set_input_delay 0.057 -clock vclk [get_ports sel_4]
set_input_delay 0.121 -clock vclk [get_ports sel_5]
set_input_delay 0.1 -clock vclk [get_ports sel_6]
set_input_delay 0.124 -clock vclk [get_ports sel_7]
set_input_delay 0.095 -clock vclk [get_ports sel_8]
set_input_delay 0.067 -clock vclk [get_ports sel_9]
set_input_delay 0.131 -clock vclk [get_ports sel_10]
set_input_delay 0.045 -clock vclk [get_ports sel_11]
