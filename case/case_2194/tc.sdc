set_input_delay 0.228 -clock vclk [get_ports sel_8]
set_input_delay 0.111 -clock vclk [get_ports sel_9]
set_input_delay 0.167 -clock vclk [get_ports sel_10]
set_input_delay 0.133 -clock vclk [get_ports sel_11]
set_input_delay 0.211 -clock vclk [get_ports sel_12]
