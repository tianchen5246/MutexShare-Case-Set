create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.26 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.154 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.28 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.297 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.241 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.272 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.202 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.295 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.244 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.136 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.213 -clock vclk [get_ports sel_6[1]]
