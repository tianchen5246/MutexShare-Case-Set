create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.327 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.311 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.301 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.312 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.286 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.307 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.287 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.302 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.291 -clock vclk [get_ports sel_3[2]]
