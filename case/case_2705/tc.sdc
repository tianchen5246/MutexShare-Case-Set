create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.295 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.12 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.29 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.273 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.131 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.313 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.346 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.355 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.242 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.244 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.354 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.16 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.159 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.318 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.214 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.086 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.34 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.14 -clock vclk [get_ports sel_8[1]]
