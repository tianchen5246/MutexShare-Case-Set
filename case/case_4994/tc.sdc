create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.305 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.345 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.32 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.308 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.363 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.313 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.315 -clock vclk [get_ports sel_3]
set_input_delay 0.314 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.336 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.338 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.351 -clock vclk [get_ports sel_5]
set_input_delay 0.341 -clock vclk [get_ports sel_6]
set_input_delay 0.346 -clock vclk [get_ports sel_7]
