create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.068 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.102 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.19 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.157 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.142 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.162 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.139 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.109 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.162 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.15 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.157 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.204 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.077 -clock vclk [get_ports sel_8[1]]
