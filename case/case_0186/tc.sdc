create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.354 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.309 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.348 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.307 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.384 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.366 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.295 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.208 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.254 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.306 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.303 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.303 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.352 -clock vclk [get_ports sel_7[1]]
