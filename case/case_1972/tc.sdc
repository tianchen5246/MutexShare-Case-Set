create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.159 -clock vclk [get_ports sel_1]
set_input_delay 0.137 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.208 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.174 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.142 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.168 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.15 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.153 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.143 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.202 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.131 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_5[2]]
