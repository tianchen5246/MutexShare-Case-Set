create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.177 -clock vclk [get_ports sel_1]
set_input_delay 0.094 -clock vclk [get_ports sel_2]
set_input_delay 0.091 -clock vclk [get_ports sel_3]
set_input_delay 0.108 -clock vclk [get_ports sel_4]
set_input_delay 0.126 -clock vclk [get_ports sel_5]
set_input_delay 0.135 -clock vclk [get_ports sel_6]
set_input_delay 0.115 -clock vclk [get_ports sel_7]
set_input_delay 0.152 -clock vclk [get_ports sel_8]
set_input_delay 0.105 -clock vclk [get_ports sel_9]
