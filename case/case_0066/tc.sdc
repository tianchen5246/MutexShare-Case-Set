create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.17 -clock vclk [get_ports sel_1]
set_input_delay 0.155 -clock vclk [get_ports sel_2]
set_input_delay 0.139 -clock vclk [get_ports sel_3]
set_input_delay 0.067 -clock vclk [get_ports sel_4]
set_input_delay 0.07 -clock vclk [get_ports sel_5]
set_input_delay 0.154 -clock vclk [get_ports sel_6]
set_input_delay 0.137 -clock vclk [get_ports sel_7]
set_input_delay 0.028 -clock vclk [get_ports sel_8]
set_input_delay 0.229 -clock vclk [get_ports sel_9]
set_input_delay 0.105 -clock vclk [get_ports sel_10]
set_input_delay 0.17 -clock vclk [get_ports sel_11]
set_input_delay 0.266 -clock vclk [get_ports sel_12]
set_input_delay 0.257 -clock vclk [get_ports sel_13]
