create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.235 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.234 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.224 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.258 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.257 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.236 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.235 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.235 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.229 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.26 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.25 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.236 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.241 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.223 -clock vclk [get_ports sel_5[2]]
