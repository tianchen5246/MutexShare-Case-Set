create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.217 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.115 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.063 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.086 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.189 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.145 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.15 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.052 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.149 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.124 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.127 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.163 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.189 -clock vclk [get_ports sel_7[1]]
