set_input_delay 0.194 -clock vclk [get_ports sel_6]
set_input_delay 0.204 -clock vclk [get_ports sel_7]
set_input_delay 0.235 -clock vclk [get_ports sel_8]
set_input_delay 0.261 -clock vclk [get_ports sel_9]
set_input_delay 0.215 -clock vclk [get_ports sel_10]
set_input_delay 0.299 -clock vclk [get_ports sel_11]
set_input_delay 0.287 -clock vclk [get_ports sel_12]
