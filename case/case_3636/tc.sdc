create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.091 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.083 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.024 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.083 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.091 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.041 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.078 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.107 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.063 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.029 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.086 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.047 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.04 -clock vclk [get_ports sel_6[1]]
