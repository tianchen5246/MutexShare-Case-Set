create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.059 -clock vclk [get_ports sel_1]
set_input_delay 0.052 -clock vclk [get_ports sel_2]
set_input_delay 0.024 -clock vclk [get_ports sel_3]
set_input_delay 0.047 -clock vclk [get_ports sel_4]
set_input_delay 0.023 -clock vclk [get_ports sel_5]
set_input_delay 0.058 -clock vclk [get_ports sel_6]
set_input_delay 0.028 -clock vclk [get_ports sel_7]
set_input_delay 0.025 -clock vclk [get_ports sel_8]
set_input_delay 0.019 -clock vclk [get_ports sel_9]
set_input_delay 0.03 -clock vclk [get_ports sel_10]
set_input_delay 0.027 -clock vclk [get_ports sel_11]
