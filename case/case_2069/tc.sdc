create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.293 -clock vclk [get_ports sel_1]
set_input_delay 0.247 -clock vclk [get_ports sel_2]
set_input_delay 0.291 -clock vclk [get_ports sel_3]
set_input_delay 0.234 -clock vclk [get_ports sel_4]
set_input_delay 0.298 -clock vclk [get_ports sel_5]
set_input_delay 0.294 -clock vclk [get_ports sel_6]
set_input_delay 0.248 -clock vclk [get_ports sel_7]
set_input_delay 0.275 -clock vclk [get_ports sel_8]
set_input_delay 0.283 -clock vclk [get_ports sel_9]
set_input_delay 0.26 -clock vclk [get_ports sel_10]
