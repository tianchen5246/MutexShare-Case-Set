set_input_delay 0.211 -clock vclk [get_ports sel_5]
set_input_delay 0.183 -clock vclk [get_ports sel_6]
set_input_delay 0.074 -clock vclk [get_ports sel_7]
set_input_delay 0.134 -clock vclk [get_ports sel_8]
set_input_delay 0.231 -clock vclk [get_ports sel_9]
set_input_delay 0.184 -clock vclk [get_ports sel_10]
set_input_delay 0.174 -clock vclk [get_ports sel_11]
set_input_delay 0.273 -clock vclk [get_ports sel_12]
set_input_delay 0.281 -clock vclk [get_ports sel_13]
