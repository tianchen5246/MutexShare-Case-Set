create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.108 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.182 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_2]
set_input_delay 0.089 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.169 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.253 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.103 -clock vclk [get_ports sel_4]
set_input_delay 0.183 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.166 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.205 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.259 -clock vclk [get_ports sel_6]
set_input_delay 0.066 -clock vclk [get_ports sel_7]
set_input_delay 0.112 -clock vclk [get_ports sel_8]
set_input_delay 0.157 -clock vclk [get_ports sel_9]
