create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.209 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.077 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.072 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.192 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.164 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.069 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.186 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.158 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.2 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.098 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.161 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.067 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.12 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.047 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.233 -clock vclk [get_ports sel_6[1]]
