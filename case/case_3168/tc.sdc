create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.117 -clock vclk [get_ports sel_1]
set_input_delay 0.092 -clock vclk [get_ports sel_2]
set_input_delay 0.111 -clock vclk [get_ports sel_3]
set_input_delay 0.11 -clock vclk [get_ports sel_4]
set_input_delay 0.114 -clock vclk [get_ports sel_5]
set_input_delay 0.108 -clock vclk [get_ports sel_6]
set_input_delay 0.096 -clock vclk [get_ports sel_7]
set_input_delay 0.108 -clock vclk [get_ports sel_8]
set_input_delay 0.085 -clock vclk [get_ports sel_9]
