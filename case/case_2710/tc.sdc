create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.255 -clock vclk [get_ports sel_1]
set_input_delay 0.272 -clock vclk [get_ports sel_2]
set_input_delay 0.244 -clock vclk [get_ports sel_3]
set_input_delay 0.254 -clock vclk [get_ports sel_4]
set_input_delay 0.274 -clock vclk [get_ports sel_5]
set_input_delay 0.255 -clock vclk [get_ports sel_6]
set_input_delay 0.256 -clock vclk [get_ports sel_7]
set_input_delay 0.248 -clock vclk [get_ports sel_8]
set_input_delay 0.255 -clock vclk [get_ports sel_9]
set_input_delay 0.241 -clock vclk [get_ports sel_10]
set_input_delay 0.271 -clock vclk [get_ports sel_11]
set_input_delay 0.242 -clock vclk [get_ports sel_12]
set_input_delay 0.24 -clock vclk [get_ports sel_13]
