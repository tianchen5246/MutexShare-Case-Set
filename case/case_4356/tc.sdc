create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.227 -clock vclk [get_ports sel_1]
set_input_delay 0.239 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.217 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.248 -clock vclk [get_ports sel_3]
set_input_delay 0.235 -clock vclk [get_ports sel_4]
set_input_delay 0.2 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.218 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.242 -clock vclk [get_ports sel_6]
set_input_delay 0.228 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.245 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.215 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.241 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.222 -clock vclk [get_ports sel_9]
set_input_delay 0.239 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.217 -clock vclk [get_ports sel_11[0]]
set_input_delay 0.208 -clock vclk [get_ports sel_11[1]]
