create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.284 -clock vclk [get_ports sel_1]
set_input_delay 0.178 -clock vclk [get_ports sel_2]
set_input_delay 0.149 -clock vclk [get_ports sel_3]
set_input_delay 0.118 -clock vclk [get_ports sel_4]
set_input_delay 0.2 -clock vclk [get_ports sel_5]
set_input_delay 0.129 -clock vclk [get_ports sel_6]
set_input_delay 0.108 -clock vclk [get_ports sel_7]
set_input_delay 0.153 -clock vclk [get_ports sel_8]
set_input_delay 0.227 -clock vclk [get_ports sel_9]
set_input_delay 0.31 -clock vclk [get_ports sel_10]
set_input_delay 0.214 -clock vclk [get_ports sel_11]
