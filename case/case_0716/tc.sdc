create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.066 -clock vclk [get_ports sel_1]
set_input_delay 0.188 -clock vclk [get_ports sel_2]
set_input_delay 0.192 -clock vclk [get_ports sel_3]
set_input_delay 0.177 -clock vclk [get_ports sel_4]
set_input_delay 0.05 -clock vclk [get_ports sel_5]
set_input_delay 0.124 -clock vclk [get_ports sel_6]
set_input_delay 0.169 -clock vclk [get_ports sel_7]
set_input_delay 0.097 -clock vclk [get_ports sel_8]
set_input_delay 0.152 -clock vclk [get_ports sel_9]
set_input_delay 0.127 -clock vclk [get_ports sel_10]
set_input_delay 0.136 -clock vclk [get_ports sel_11]
set_input_delay 0.191 -clock vclk [get_ports sel_12]
set_input_delay 0.187 -clock vclk [get_ports sel_13]
