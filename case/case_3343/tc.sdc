create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.338 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.325 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.327 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.319 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.336 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.331 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.344 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.329 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.346 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.342 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.329 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.319 -clock vclk [get_ports sel_4[2]]
