create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.159 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.172 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.193 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.147 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.195 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.184 -clock vclk [get_ports sel_3[2]]
