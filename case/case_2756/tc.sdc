create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.07 -clock vclk [get_ports sel_1]
set_input_delay 0.131 -clock vclk [get_ports sel_2]
set_input_delay 0.077 -clock vclk [get_ports sel_3]
set_input_delay 0.027 -clock vclk [get_ports sel_4]
set_input_delay 0.287 -clock vclk [get_ports sel_5]
set_input_delay 0.175 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.177 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.144 -clock vclk [get_ports sel_7]
