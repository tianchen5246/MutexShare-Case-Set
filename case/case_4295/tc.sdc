create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.023 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.041 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.02 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.039 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.029 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.027 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.034 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.022 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.017 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.039 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.031 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.031 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.027 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.016 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.03 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.019 -clock vclk [get_ports sel_8[1]]
