create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.216 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.21 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.164 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.22 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.16 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.162 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.213 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.159 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.16 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_4[1]]
