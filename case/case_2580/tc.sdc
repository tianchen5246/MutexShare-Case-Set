create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.254 -clock vclk [get_ports sel_1]
set_input_delay 0.265 -clock vclk [get_ports sel_2]
set_input_delay 0.346 -clock vclk [get_ports sel_3]
set_input_delay 0.158 -clock vclk [get_ports sel_4]
set_input_delay 0.26 -clock vclk [get_ports sel_5]
set_input_delay 0.332 -clock vclk [get_ports sel_6]
set_input_delay 0.389 -clock vclk [get_ports sel_7]
set_input_delay 0.377 -clock vclk [get_ports sel_8]
set_input_delay 0.22 -clock vclk [get_ports sel_9]
set_input_delay 0.193 -clock vclk [get_ports sel_10]
set_input_delay 0.156 -clock vclk [get_ports sel_11]
