create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.195 -clock vclk [get_ports sel_1]
set_input_delay 0.186 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.178 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.244 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.207 -clock vclk [get_ports sel_3]
set_input_delay 0.209 -clock vclk [get_ports sel_4]
set_input_delay 0.188 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.185 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.216 -clock vclk [get_ports sel_6]
set_input_delay 0.169 -clock vclk [get_ports sel_7]
set_input_delay 0.169 -clock vclk [get_ports sel_8]
set_input_delay 0.2 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.235 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.242 -clock vclk [get_ports sel_9[2]]
