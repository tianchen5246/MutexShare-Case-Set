create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.311 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.262 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.156 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.26 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.333 -clock vclk [get_ports sel_3]
set_input_delay 0.299 -clock vclk [get_ports sel_4]
set_input_delay 0.187 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.309 -clock vclk [get_ports sel_5[1]]
