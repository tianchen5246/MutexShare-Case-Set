create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.364 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.343 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.373 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.291 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.336 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.287 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.171 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.172 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.268 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.273 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.239 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.314 -clock vclk [get_ports sel_5[1]]
