create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.022 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.085 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.208 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.057 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.104 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.237 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.176 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.198 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.037 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.059 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.079 -clock vclk [get_ports sel_5[1]]
