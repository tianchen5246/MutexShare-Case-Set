create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.185 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.28 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.182 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.295 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.245 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.248 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.3 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.25 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.242 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_6[1]]
