create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.206 -clock vclk [get_ports sel_1]
set_input_delay 0.24 -clock vclk [get_ports sel_2]
set_input_delay 0.203 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.185 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.256 -clock vclk [get_ports sel_4]
set_input_delay 0.213 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.22 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.218 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.206 -clock vclk [get_ports sel_6]
set_input_delay 0.238 -clock vclk [get_ports sel_7]
