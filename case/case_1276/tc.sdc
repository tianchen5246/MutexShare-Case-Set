create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.192 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.171 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.203 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.171 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.189 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.227 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.239 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.235 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.166 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.174 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.223 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.211 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.19 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_5[2]]
