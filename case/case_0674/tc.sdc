create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.151 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.131 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.116 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.16 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.165 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.202 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.2 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.214 -clock vclk [get_ports sel_3[2]]
