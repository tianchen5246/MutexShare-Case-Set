create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.21 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.227 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.318 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.264 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.029 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.217 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.008 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.263 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.075 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.301 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.09 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.148 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.11 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.047 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.074 -clock vclk [get_ports sel_5[2]]
