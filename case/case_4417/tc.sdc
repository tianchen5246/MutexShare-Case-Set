set_input_delay 0.243 -clock vclk [get_ports sel_6]
set_input_delay 0.237 -clock vclk [get_ports sel_7]
set_input_delay 0.218 -clock vclk [get_ports sel_8]
set_input_delay 0.224 -clock vclk [get_ports sel_9]
set_input_delay 0.227 -clock vclk [get_ports sel_10]
set_input_delay 0.221 -clock vclk [get_ports sel_11]
set_input_delay 0.225 -clock vclk [get_ports sel_12]
set_input_delay 0.246 -clock vclk [get_ports sel_13]
set_input_delay 0.24 -clock vclk [get_ports sel_14]
set_input_delay 0.231 -clock vclk [get_ports sel_15]
