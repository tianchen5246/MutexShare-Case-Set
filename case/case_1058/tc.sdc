create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.044 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.065 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.146 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.028 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.131 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.032 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.035 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.069 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.202 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.164 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.071 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.066 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.18 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.064 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.049 -clock vclk [get_ports sel_8[1]]
