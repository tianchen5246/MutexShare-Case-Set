create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.33 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.323 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.322 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.346 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.34 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.335 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.34 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.324 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.345 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.343 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.346 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.344 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.332 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.342 -clock vclk [get_ports sel_7[1]]
