create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.134 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.072 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.326 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.213 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.087 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.251 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.109 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.328 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.083 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.147 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.018 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.078 -clock vclk [get_ports sel_7[1]]
