create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.065 -clock vclk [get_ports sel_1]
set_input_delay 0.067 -clock vclk [get_ports sel_2]
set_input_delay 0.062 -clock vclk [get_ports sel_3]
set_input_delay 0.074 -clock vclk [get_ports sel_4]
set_input_delay 0.064 -clock vclk [get_ports sel_5]
set_input_delay 0.059 -clock vclk [get_ports sel_6]
set_input_delay 0.072 -clock vclk [get_ports sel_7]
set_input_delay 0.055 -clock vclk [get_ports sel_8]
set_input_delay 0.075 -clock vclk [get_ports sel_9]
set_input_delay 0.075 -clock vclk [get_ports sel_10]
set_input_delay 0.07 -clock vclk [get_ports sel_11]
set_input_delay 0.064 -clock vclk [get_ports sel_12]
