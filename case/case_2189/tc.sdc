set_input_delay 0.255 -clock vclk [get_ports sel_6]
set_input_delay 0.223 -clock vclk [get_ports sel_7]
set_input_delay 0.122 -clock vclk [get_ports sel_8]
set_input_delay 0.236 -clock vclk [get_ports sel_9]
set_input_delay 0.152 -clock vclk [get_ports sel_10]
set_input_delay 0.162 -clock vclk [get_ports sel_11]
set_input_delay 0.137 -clock vclk [get_ports sel_12]
set_input_delay 0.265 -clock vclk [get_ports sel_13]
set_input_delay 0.207 -clock vclk [get_ports sel_14]
