create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.028 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.055 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.035 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.024 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.046 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.027 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.031 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.029 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.049 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.058 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.021 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.035 -clock vclk [get_ports sel_5[1]]
