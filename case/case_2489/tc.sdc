create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.116 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.064 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.142 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.064 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.061 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.158 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.148 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.073 -clock vclk [get_ports sel_4]
set_input_delay 0.116 -clock vclk [get_ports sel_5]
set_input_delay 0.108 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.174 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.102 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.186 -clock vclk [get_ports sel_7]
set_input_delay 0.173 -clock vclk [get_ports sel_8]
