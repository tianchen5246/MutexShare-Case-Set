create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.284 -clock vclk [get_ports sel_1]
set_input_delay 0.285 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.26 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_3]
set_input_delay 0.243 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.28 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.214 -clock vclk [get_ports sel_5]
set_input_delay 0.251 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.284 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.257 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.271 -clock vclk [get_ports sel_8]
set_input_delay 0.232 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.281 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.257 -clock vclk [get_ports sel_10[1]]
