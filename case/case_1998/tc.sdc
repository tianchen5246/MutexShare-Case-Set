create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.096 -clock vclk [get_ports sel_1]
set_input_delay 0.127 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.301 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.11 -clock vclk [get_ports sel_3]
set_input_delay 0.136 -clock vclk [get_ports sel_4]
set_input_delay 0.202 -clock vclk [get_ports sel_5]
set_input_delay 0.167 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.249 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.197 -clock vclk [get_ports sel_7]
set_input_delay 0.235 -clock vclk [get_ports sel_8]
set_input_delay 0.278 -clock vclk [get_ports sel_9]
set_input_delay 0.235 -clock vclk [get_ports sel_10]
set_input_delay 0.225 -clock vclk [get_ports sel_11]
set_input_delay 0.246 -clock vclk [get_ports sel_12[0]]
set_input_delay 0.13 -clock vclk [get_ports sel_12[1]]
set_input_delay 0.2 -clock vclk [get_ports sel_12[2]]
