create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.304 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.253 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.312 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.316 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.224 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.169 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.12 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.303 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.131 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.266 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.213 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.137 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_5[2]]
