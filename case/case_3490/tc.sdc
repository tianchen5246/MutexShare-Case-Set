create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.16 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.138 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.105 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.194 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.097 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.267 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.187 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.258 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.24 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.153 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.124 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.126 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.152 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.239 -clock vclk [get_ports sel_8[1]]
