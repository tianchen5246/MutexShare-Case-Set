create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.202 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.065 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.119 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.143 -clock vclk [get_ports sel_2]
set_input_delay 0.213 -clock vclk [get_ports sel_3]
set_input_delay 0.193 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.048 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.078 -clock vclk [get_ports sel_5]
set_input_delay 0.137 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.176 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.095 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.138 -clock vclk [get_ports sel_7]
