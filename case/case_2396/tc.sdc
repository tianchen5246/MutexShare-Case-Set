create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.277 -clock vclk [get_ports sel_1]
set_input_delay 0.272 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.292 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.282 -clock vclk [get_ports sel_3]
set_input_delay 0.18 -clock vclk [get_ports sel_4]
set_input_delay 0.181 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.252 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.222 -clock vclk [get_ports sel_6]
set_input_delay 0.335 -clock vclk [get_ports sel_7]
