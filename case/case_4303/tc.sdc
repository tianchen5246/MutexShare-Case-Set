create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.196 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.2 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.194 -clock vclk [get_ports sel_2]
set_input_delay 0.196 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.198 -clock vclk [get_ports sel_4]
set_input_delay 0.195 -clock vclk [get_ports sel_5]
set_input_delay 0.197 -clock vclk [get_ports sel_6]
set_input_delay 0.196 -clock vclk [get_ports sel_7]
set_input_delay 0.195 -clock vclk [get_ports sel_8]
set_input_delay 0.193 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.198 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.196 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.198 -clock vclk [get_ports sel_10[1]]
