create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.214 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.233 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.228 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.242 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.209 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_3[2]]
