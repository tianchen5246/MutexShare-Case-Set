create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.254 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.182 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.039 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.162 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.024 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.116 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.055 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.124 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.033 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.163 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.142 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.209 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.198 -clock vclk [get_ports sel_8[1]]
