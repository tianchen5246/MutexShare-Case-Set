create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.287 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.091 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.277 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.277 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.268 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.322 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.29 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.071 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.244 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.363 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.259 -clock vclk [get_ports sel_4[2]]
