create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.042 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.042 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.139 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.086 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.141 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.138 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.055 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.075 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.072 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.099 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.074 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.07 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.037 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.087 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.043 -clock vclk [get_ports sel_5[2]]
