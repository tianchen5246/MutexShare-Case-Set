create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.307 -clock vclk [get_ports sel_1]
set_input_delay 0.305 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.313 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_3]
set_input_delay 0.298 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.311 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.298 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.309 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.315 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.313 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.299 -clock vclk [get_ports sel_7]
set_input_delay 0.301 -clock vclk [get_ports sel_8]
set_input_delay 0.3 -clock vclk [get_ports sel_9]
