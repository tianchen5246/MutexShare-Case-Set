create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.022 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.073 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.029 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.099 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.098 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.081 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.022 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.019 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.006 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.066 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.075 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.007 -clock vclk [get_ports sel_7[1]]
