create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.139 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.189 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.228 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.206 -clock vclk [get_ports sel_2]
set_input_delay 0.14 -clock vclk [get_ports sel_3]
set_input_delay 0.242 -clock vclk [get_ports sel_4]
set_input_delay 0.155 -clock vclk [get_ports sel_5]
set_input_delay 0.202 -clock vclk [get_ports sel_6]
set_input_delay 0.209 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.239 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.171 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.261 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.177 -clock vclk [get_ports sel_10]
