create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.082 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.092 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.076 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.051 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.104 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.119 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.076 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.069 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.101 -clock vclk [get_ports sel_5[1]]
