create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.239 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.307 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.314 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.24 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.238 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.26 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.301 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.271 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.294 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.325 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.273 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.242 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.261 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.269 -clock vclk [get_ports sel_5[2]]
