create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.197 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.108 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.096 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.172 -clock vclk [get_ports sel_2]
set_input_delay 0.226 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.092 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.082 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.239 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.103 -clock vclk [get_ports sel_5]
set_input_delay 0.161 -clock vclk [get_ports sel_6]
set_input_delay 0.161 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.113 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.232 -clock vclk [get_ports sel_8]
