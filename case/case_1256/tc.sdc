create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.343 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.195 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.159 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.299 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.354 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.335 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.342 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.237 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.347 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.355 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.286 -clock vclk [get_ports sel_4[2]]
