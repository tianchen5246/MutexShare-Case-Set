create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.341 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.34 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.357 -clock vclk [get_ports sel_2]
set_input_delay 0.278 -clock vclk [get_ports sel_3]
set_input_delay 0.227 -clock vclk [get_ports sel_4]
set_input_delay 0.229 -clock vclk [get_ports sel_5]
set_input_delay 0.376 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.166 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.191 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.344 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.306 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.161 -clock vclk [get_ports sel_8]
set_input_delay 0.35 -clock vclk [get_ports sel_9]
set_input_delay 0.165 -clock vclk [get_ports sel_10]
set_input_delay 0.144 -clock vclk [get_ports sel_11]
