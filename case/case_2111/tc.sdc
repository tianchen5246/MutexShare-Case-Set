create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.135 -clock vclk [get_ports sel_1]
set_input_delay 0.208 -clock vclk [get_ports sel_2]
set_input_delay 0.215 -clock vclk [get_ports sel_3]
set_input_delay 0.132 -clock vclk [get_ports sel_4]
set_input_delay 0.192 -clock vclk [get_ports sel_5]
set_input_delay 0.161 -clock vclk [get_ports sel_6]
set_input_delay 0.173 -clock vclk [get_ports sel_7]
set_input_delay 0.125 -clock vclk [get_ports sel_8]
set_input_delay 0.212 -clock vclk [get_ports sel_9]
set_input_delay 0.138 -clock vclk [get_ports sel_10]
set_input_delay 0.159 -clock vclk [get_ports sel_11]
set_input_delay 0.168 -clock vclk [get_ports sel_12]
set_input_delay 0.204 -clock vclk [get_ports sel_13]
