create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.288 -clock vclk [get_ports sel_1]
set_input_delay 0.124 -clock vclk [get_ports sel_2]
set_input_delay 0.32 -clock vclk [get_ports sel_3]
set_input_delay 0.23 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.228 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_5]
set_input_delay 0.311 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.166 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.317 -clock vclk [get_ports sel_7]
set_input_delay 0.206 -clock vclk [get_ports sel_8]
set_input_delay 0.236 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.2 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.207 -clock vclk [get_ports sel_10]
set_input_delay 0.174 -clock vclk [get_ports sel_11]
