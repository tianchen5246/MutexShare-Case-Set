create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.285 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.318 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.339 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.343 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.322 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.31 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.343 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.279 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.277 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.317 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.338 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.285 -clock vclk [get_ports sel_4[2]]
