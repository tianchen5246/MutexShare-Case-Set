create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.323 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.34 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.313 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.299 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.315 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.288 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.305 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.348 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.298 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.338 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.298 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.307 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.354 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.35 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.333 -clock vclk [get_ports sel_5[2]]
