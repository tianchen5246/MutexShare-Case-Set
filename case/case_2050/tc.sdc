create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.076 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.152 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.071 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.134 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.251 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.066 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.252 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.224 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.232 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.146 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.117 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.15 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.175 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.205 -clock vclk [get_ports sel_6[2]]
