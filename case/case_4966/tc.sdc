create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.188 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.041 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.165 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.099 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.258 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.103 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.114 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.235 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.13 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.098 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.171 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.161 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.05 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.12 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.088 -clock vclk [get_ports sel_5[2]]
