create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.185 -clock vclk [get_ports sel_1]
set_input_delay 0.191 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.107 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.199 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.129 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_4]
set_input_delay 0.201 -clock vclk [get_ports sel_5]
set_input_delay 0.118 -clock vclk [get_ports sel_6]
set_input_delay 0.205 -clock vclk [get_ports sel_7]
set_input_delay 0.1 -clock vclk [get_ports sel_8]
set_input_delay 0.159 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.09 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_10]
set_input_delay 0.184 -clock vclk [get_ports sel_11]
set_input_delay 0.084 -clock vclk [get_ports sel_12]
