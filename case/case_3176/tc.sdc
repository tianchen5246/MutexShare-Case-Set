create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.247 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.114 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.095 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.159 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.247 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.089 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.182 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.249 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.161 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.231 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.25 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.203 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.058 -clock vclk [get_ports sel_5[2]]
