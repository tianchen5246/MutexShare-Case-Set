create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.067 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.105 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.061 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.097 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.08 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.075 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.09 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.13 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.118 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.078 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.09 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.09 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.123 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.082 -clock vclk [get_ports sel_7[1]]
