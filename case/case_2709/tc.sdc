create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.34 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.344 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.367 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.363 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.356 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.342 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.337 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.349 -clock vclk [get_ports sel_5]
set_input_delay 0.302 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.335 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.346 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.368 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.363 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.31 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.355 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.356 -clock vclk [get_ports sel_9[1]]
