create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.168 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.141 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.207 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.171 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.31 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.31 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.208 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.325 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.237 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.225 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.197 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.126 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.253 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.282 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.259 -clock vclk [get_ports sel_5[2]]
