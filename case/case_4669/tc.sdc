set_input_delay 0.28 -clock vclk [get_ports sel_8]
set_input_delay 0.19 -clock vclk [get_ports sel_9]
set_input_delay 0.324 -clock vclk [get_ports sel_10]
set_input_delay 0.145 -clock vclk [get_ports sel_11]
set_input_delay 0.221 -clock vclk [get_ports sel_12]
set_input_delay 0.249 -clock vclk [get_ports sel_13]
