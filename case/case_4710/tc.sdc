create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.116 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.049 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.196 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.203 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.121 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.162 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.075 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.035 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.16 -clock vclk [get_ports sel_3[2]]
