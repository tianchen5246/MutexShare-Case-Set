create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.342 -clock vclk [get_ports sel_1]
set_input_delay 0.352 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.334 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.336 -clock vclk [get_ports sel_3]
set_input_delay 0.355 -clock vclk [get_ports sel_4]
set_input_delay 0.33 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.352 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.342 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.354 -clock vclk [get_ports sel_6]
set_input_delay 0.332 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.336 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.344 -clock vclk [get_ports sel_7[2]]
set_input_delay 0.332 -clock vclk [get_ports sel_8]
set_input_delay 0.353 -clock vclk [get_ports sel_9]
