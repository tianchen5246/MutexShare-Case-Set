create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.282 -clock vclk [get_ports sel_1]
set_input_delay 0.144 -clock vclk [get_ports sel_2]
set_input_delay 0.171 -clock vclk [get_ports sel_3]
set_input_delay 0.239 -clock vclk [get_ports sel_4]
set_input_delay 0.281 -clock vclk [get_ports sel_5]
set_input_delay 0.074 -clock vclk [get_ports sel_6]
set_input_delay 0.038 -clock vclk [get_ports sel_7]
set_input_delay 0.258 -clock vclk [get_ports sel_8]
set_input_delay 0.03 -clock vclk [get_ports sel_9]
set_input_delay 0.101 -clock vclk [get_ports sel_10]
