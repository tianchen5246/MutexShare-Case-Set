set_input_delay 0.149 -clock vclk [get_ports sel_5]
set_input_delay 0.258 -clock vclk [get_ports sel_6]
set_input_delay 0.254 -clock vclk [get_ports sel_7]
set_input_delay 0.131 -clock vclk [get_ports sel_8]
set_input_delay 0.12 -clock vclk [get_ports sel_9]
set_input_delay 0.092 -clock vclk [get_ports sel_10]
set_input_delay 0.188 -clock vclk [get_ports sel_11]
set_input_delay 0.175 -clock vclk [get_ports sel_12]
set_input_delay 0.224 -clock vclk [get_ports sel_13]
set_input_delay 0.122 -clock vclk [get_ports sel_14]
