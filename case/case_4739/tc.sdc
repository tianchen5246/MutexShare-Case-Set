create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.32 -clock vclk [get_ports sel_1]
set_input_delay 0.071 -clock vclk [get_ports sel_2]
set_input_delay 0.051 -clock vclk [get_ports sel_3]
set_input_delay 0.177 -clock vclk [get_ports sel_4]
set_input_delay 0.227 -clock vclk [get_ports sel_5]
set_input_delay 0.212 -clock vclk [get_ports sel_6]
set_input_delay 0.198 -clock vclk [get_ports sel_7]
set_input_delay 0.106 -clock vclk [get_ports sel_8]
set_input_delay 0.062 -clock vclk [get_ports sel_9]
