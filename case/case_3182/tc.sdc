create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.241 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.312 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.325 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.268 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.311 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.25 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.313 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.218 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.25 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.315 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.335 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.269 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.262 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.246 -clock vclk [get_ports sel_5[2]]
