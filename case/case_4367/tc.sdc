create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.027 -clock vclk [get_ports sel_1]
set_input_delay 0.103 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.064 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.097 -clock vclk [get_ports sel_3]
set_input_delay 0.126 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.019 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.076 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.03 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.051 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.125 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.124 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.045 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.065 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.043 -clock vclk [get_ports sel_7]
