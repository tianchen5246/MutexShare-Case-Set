create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.352 -clock vclk [get_ports sel_1]
set_input_delay 0.322 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.302 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.351 -clock vclk [get_ports sel_3]
set_input_delay 0.095 -clock vclk [get_ports sel_4]
set_input_delay 0.133 -clock vclk [get_ports sel_5]
set_input_delay 0.257 -clock vclk [get_ports sel_6]
set_input_delay 0.341 -clock vclk [get_ports sel_7]
set_input_delay 0.251 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.244 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.147 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.175 -clock vclk [get_ports sel_9[2]]
set_input_delay 0.206 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.105 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.111 -clock vclk [get_ports sel_10[2]]
set_input_delay 0.116 -clock vclk [get_ports sel_11]
set_input_delay 0.287 -clock vclk [get_ports sel_12]
