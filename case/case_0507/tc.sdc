create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.25 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.224 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.151 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.276 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.202 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.152 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.172 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.114 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.139 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.239 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.176 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.263 -clock vclk [get_ports sel_5[2]]
