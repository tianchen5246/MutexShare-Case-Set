set_input_delay 0.229 -clock vclk [get_ports sel_5]
set_input_delay 0.256 -clock vclk [get_ports sel_6]
set_input_delay 0.201 -clock vclk [get_ports sel_7]
set_input_delay 0.246 -clock vclk [get_ports sel_8]
set_input_delay 0.244 -clock vclk [get_ports sel_9]
set_input_delay 0.198 -clock vclk [get_ports sel_10]
set_input_delay 0.244 -clock vclk [get_ports sel_11]
set_input_delay 0.19 -clock vclk [get_ports sel_12]
set_input_delay 0.252 -clock vclk [get_ports sel_13]
set_input_delay 0.262 -clock vclk [get_ports sel_14]
