create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.142 -clock vclk [get_ports sel_1]
set_input_delay 0.183 -clock vclk [get_ports sel_2]
set_input_delay 0.108 -clock vclk [get_ports sel_3]
set_input_delay 0.227 -clock vclk [get_ports sel_4]
set_input_delay 0.095 -clock vclk [get_ports sel_5]
set_input_delay 0.078 -clock vclk [get_ports sel_6]
set_input_delay 0.188 -clock vclk [get_ports sel_7]
set_input_delay 0.093 -clock vclk [get_ports sel_8]
