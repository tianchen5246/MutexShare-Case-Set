create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.053 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.116 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.175 -clock vclk [get_ports sel_2]
set_input_delay 0.232 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.217 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.141 -clock vclk [get_ports sel_3[2]]
