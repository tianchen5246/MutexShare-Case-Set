create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.07 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.128 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.137 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.14 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.221 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.087 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.187 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.102 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.198 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.119 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.066 -clock vclk [get_ports sel_6[1]]
