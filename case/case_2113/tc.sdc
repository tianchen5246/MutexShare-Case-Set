create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.215 -clock vclk [get_ports sel_1]
set_input_delay 0.209 -clock vclk [get_ports sel_2]
set_input_delay 0.195 -clock vclk [get_ports sel_3]
set_input_delay 0.177 -clock vclk [get_ports sel_4]
set_input_delay 0.201 -clock vclk [get_ports sel_5]
set_input_delay 0.162 -clock vclk [get_ports sel_6]
set_input_delay 0.239 -clock vclk [get_ports sel_7]
set_input_delay 0.204 -clock vclk [get_ports sel_8]
set_input_delay 0.224 -clock vclk [get_ports sel_9]
