create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.222 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.212 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.154 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.132 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.187 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.085 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.203 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.107 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.098 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.208 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.065 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.157 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.196 -clock vclk [get_ports sel_6[1]]
