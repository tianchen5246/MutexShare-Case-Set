create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.167 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.096 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.091 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.146 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.134 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.104 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.172 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.171 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.137 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.156 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.162 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.129 -clock vclk [get_ports sel_8[1]]
