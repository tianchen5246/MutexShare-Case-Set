create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.251 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.233 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.24 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.24 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.235 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.223 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.253 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.247 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.224 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.253 -clock vclk [get_ports sel_7[1]]
