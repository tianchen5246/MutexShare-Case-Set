create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.144 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.264 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.142 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.147 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.135 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.115 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.058 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.267 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.125 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.074 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.085 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.268 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.248 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.096 -clock vclk [get_ports sel_7[1]]
