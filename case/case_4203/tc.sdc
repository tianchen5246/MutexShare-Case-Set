create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.189 -clock vclk [get_ports sel_1]
set_input_delay 0.221 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.189 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.176 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.211 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.187 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.203 -clock vclk [get_ports sel_4]
set_input_delay 0.207 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.188 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.215 -clock vclk [get_ports sel_6[1]]
