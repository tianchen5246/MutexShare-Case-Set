create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.256 -clock vclk [get_ports sel_1]
set_input_delay 0.057 -clock vclk [get_ports sel_2]
set_input_delay 0.142 -clock vclk [get_ports sel_3]
set_input_delay 0.258 -clock vclk [get_ports sel_4]
set_input_delay 0.277 -clock vclk [get_ports sel_5]
set_input_delay 0.304 -clock vclk [get_ports sel_6]
set_input_delay 0.218 -clock vclk [get_ports sel_7]
