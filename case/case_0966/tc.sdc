create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.23 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.217 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.202 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.234 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.232 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.238 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.24 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.232 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.228 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.209 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.192 -clock vclk [get_ports sel_6[1]]
