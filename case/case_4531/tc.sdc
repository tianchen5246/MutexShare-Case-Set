create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.242 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.193 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.208 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.187 -clock vclk [get_ports sel_2]
set_input_delay 0.205 -clock vclk [get_ports sel_3]
set_input_delay 0.174 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.155 -clock vclk [get_ports sel_4[1]]
