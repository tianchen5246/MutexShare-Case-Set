create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.288 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.26 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.141 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.172 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.189 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.298 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.183 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.128 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.261 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.166 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.208 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.217 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.112 -clock vclk [get_ports sel_5[2]]
