set_input_delay 0.25 -clock vclk [get_ports sel_5]
set_input_delay 0.248 -clock vclk [get_ports sel_6]
set_input_delay 0.15 -clock vclk [get_ports sel_7]
set_input_delay 0.156 -clock vclk [get_ports sel_8]
set_input_delay 0.255 -clock vclk [get_ports sel_9]
set_input_delay 0.24 -clock vclk [get_ports sel_10]
set_input_delay 0.22 -clock vclk [get_ports sel_11]
set_input_delay 0.2 -clock vclk [get_ports sel_12]
set_input_delay 0.121 -clock vclk [get_ports sel_13]
set_input_delay 0.236 -clock vclk [get_ports sel_14]
set_input_delay 0.171 -clock vclk [get_ports sel_15]
