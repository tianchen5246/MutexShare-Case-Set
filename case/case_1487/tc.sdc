create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.034 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.08 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.093 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.1 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.101 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.089 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.04 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.112 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.048 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.087 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.099 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.044 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.112 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.06 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.059 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.066 -clock vclk [get_ports sel_8[1]]
