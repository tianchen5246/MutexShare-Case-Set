create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.338 -clock vclk [get_ports sel_1]
set_input_delay 0.222 -clock vclk [get_ports sel_2]
set_input_delay 0.332 -clock vclk [get_ports sel_3]
set_input_delay 0.35 -clock vclk [get_ports sel_4]
set_input_delay 0.214 -clock vclk [get_ports sel_5]
set_input_delay 0.193 -clock vclk [get_ports sel_6]
set_input_delay 0.358 -clock vclk [get_ports sel_7]
set_input_delay 0.321 -clock vclk [get_ports sel_8]
set_input_delay 0.191 -clock vclk [get_ports sel_9]
set_input_delay 0.215 -clock vclk [get_ports sel_10]
