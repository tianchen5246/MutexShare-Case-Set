create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.212 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.322 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.079 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.333 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.233 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.078 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.348 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.223 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.128 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.25 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.24 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.088 -clock vclk [get_ports sel_5[2]]
