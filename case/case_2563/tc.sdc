create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.276 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.327 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.284 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.33 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.248 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.32 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.218 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.216 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.277 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.287 -clock vclk [get_ports sel_4[1]]
