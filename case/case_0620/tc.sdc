create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.207 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.065 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.172 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.208 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.102 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.104 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.079 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.047 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.147 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.205 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.101 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_6[1]]
