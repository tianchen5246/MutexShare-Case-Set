create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.113 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.105 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.061 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.106 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.123 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.071 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.104 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.125 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.122 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.108 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.126 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.087 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.077 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.064 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.096 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_7[1]]
