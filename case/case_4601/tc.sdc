create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.272 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.356 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.279 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.342 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.263 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.28 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.354 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.304 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.271 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.246 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.271 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.324 -clock vclk [get_ports sel_4[2]]
