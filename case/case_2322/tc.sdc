create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.371 -clock vclk [get_ports sel_1]
set_input_delay 0.078 -clock vclk [get_ports sel_2]
set_input_delay 0.325 -clock vclk [get_ports sel_3]
set_input_delay 0.368 -clock vclk [get_ports sel_4]
set_input_delay 0.125 -clock vclk [get_ports sel_5]
set_input_delay 0.251 -clock vclk [get_ports sel_6]
set_input_delay 0.303 -clock vclk [get_ports sel_7]
set_input_delay 0.152 -clock vclk [get_ports sel_8]
set_input_delay 0.224 -clock vclk [get_ports sel_9]
set_input_delay 0.075 -clock vclk [get_ports sel_10]
set_input_delay 0.344 -clock vclk [get_ports sel_11]
set_input_delay 0.227 -clock vclk [get_ports sel_12]
