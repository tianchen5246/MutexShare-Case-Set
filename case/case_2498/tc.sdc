create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.119 -clock vclk [get_ports sel_1]
set_input_delay 0.166 -clock vclk [get_ports sel_2]
set_input_delay 0.022 -clock vclk [get_ports sel_3]
set_input_delay 0.179 -clock vclk [get_ports sel_4]
set_input_delay 0.129 -clock vclk [get_ports sel_5]
set_input_delay 0.081 -clock vclk [get_ports sel_6]
set_input_delay 0.126 -clock vclk [get_ports sel_7]
set_input_delay 0.059 -clock vclk [get_ports sel_8]
set_input_delay 0.23 -clock vclk [get_ports sel_9]
