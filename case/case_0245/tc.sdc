create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.004 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.006 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.128 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.096 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.061 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.004 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.077 -clock vclk [get_ports sel_4[2]]
