set_input_delay 0.221 -clock vclk [get_ports sel_5]
set_input_delay 0.208 -clock vclk [get_ports sel_6]
set_input_delay 0.178 -clock vclk [get_ports sel_7]
set_input_delay 0.182 -clock vclk [get_ports sel_8]
set_input_delay 0.238 -clock vclk [get_ports sel_9]
set_input_delay 0.236 -clock vclk [get_ports sel_10]
set_input_delay 0.197 -clock vclk [get_ports sel_11]
set_input_delay 0.221 -clock vclk [get_ports sel_12]
set_input_delay 0.234 -clock vclk [get_ports sel_13]
