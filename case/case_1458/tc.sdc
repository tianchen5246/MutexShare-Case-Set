create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.114 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.07 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.09 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.075 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.136 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.138 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.12 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.119 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.094 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.157 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.134 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.106 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.102 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.157 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.15 -clock vclk [get_ports sel_6[2]]
