create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.245 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.286 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.279 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.255 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.225 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.249 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.281 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.295 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.302 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.316 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.251 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.246 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.28 -clock vclk [get_ports sel_7[1]]
