create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.075 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.34 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.046 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.032 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.27 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.312 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.331 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.097 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.316 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.055 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.042 -clock vclk [get_ports sel_5[1]]
