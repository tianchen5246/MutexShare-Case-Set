create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.181 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.162 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.162 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.166 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.178 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.201 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.181 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.172 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.206 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.182 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.175 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.186 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.213 -clock vclk [get_ports sel_5[2]]
