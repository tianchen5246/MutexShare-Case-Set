set_input_delay 0.168 -clock vclk [get_ports sel_5]
set_input_delay 0.178 -clock vclk [get_ports sel_6]
set_input_delay 0.182 -clock vclk [get_ports sel_7]
set_input_delay 0.185 -clock vclk [get_ports sel_8]
set_input_delay 0.174 -clock vclk [get_ports sel_9]
set_input_delay 0.174 -clock vclk [get_ports sel_10]
set_input_delay 0.184 -clock vclk [get_ports sel_11]
set_input_delay 0.174 -clock vclk [get_ports sel_12]
set_input_delay 0.169 -clock vclk [get_ports sel_13]
