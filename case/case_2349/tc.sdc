set_input_delay 0.278 -clock vclk [get_ports sel_5]
set_input_delay 0.21 -clock vclk [get_ports sel_6]
set_input_delay 0.21 -clock vclk [get_ports sel_7]
set_input_delay 0.216 -clock vclk [get_ports sel_8]
set_input_delay 0.315 -clock vclk [get_ports sel_9]
set_input_delay 0.257 -clock vclk [get_ports sel_10]
set_input_delay 0.311 -clock vclk [get_ports sel_11]
set_input_delay 0.358 -clock vclk [get_ports sel_12]
set_input_delay 0.079 -clock vclk [get_ports sel_13]
