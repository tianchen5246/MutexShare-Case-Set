set_input_delay 0.083 -clock vclk [get_ports sel_5]
set_input_delay 0.234 -clock vclk [get_ports sel_6]
set_input_delay 0.236 -clock vclk [get_ports sel_7]
set_input_delay 0.113 -clock vclk [get_ports sel_8]
set_input_delay 0.119 -clock vclk [get_ports sel_9]
set_input_delay 0.18 -clock vclk [get_ports sel_10]
set_input_delay 0.098 -clock vclk [get_ports sel_11]
set_input_delay 0.18 -clock vclk [get_ports sel_12]
set_input_delay 0.091 -clock vclk [get_ports sel_13]
set_input_delay 0.146 -clock vclk [get_ports sel_14]
