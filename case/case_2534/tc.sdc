create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.149 -clock vclk [get_ports sel_1]
set_input_delay 0.232 -clock vclk [get_ports sel_2]
set_input_delay 0.138 -clock vclk [get_ports sel_3]
set_input_delay 0.092 -clock vclk [get_ports sel_4]
set_input_delay 0.237 -clock vclk [get_ports sel_5]
set_input_delay 0.106 -clock vclk [get_ports sel_6]
set_input_delay 0.185 -clock vclk [get_ports sel_7]
set_input_delay 0.14 -clock vclk [get_ports sel_8]
set_input_delay 0.174 -clock vclk [get_ports sel_9]
set_input_delay 0.23 -clock vclk [get_ports sel_10]
set_input_delay 0.198 -clock vclk [get_ports sel_11]
