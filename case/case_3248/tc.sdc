create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.263 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.208 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.302 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.189 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.283 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.236 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.282 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.246 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_6[1]]
