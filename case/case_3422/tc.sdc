create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.054 -clock vclk [get_ports sel_1]
set_input_delay 0.039 -clock vclk [get_ports sel_2]
set_input_delay 0.07 -clock vclk [get_ports sel_3]
set_input_delay 0.043 -clock vclk [get_ports sel_4]
set_input_delay 0.076 -clock vclk [get_ports sel_5]
set_input_delay 0.039 -clock vclk [get_ports sel_6]
set_input_delay 0.065 -clock vclk [get_ports sel_7]
set_input_delay 0.101 -clock vclk [get_ports sel_8]
set_input_delay 0.108 -clock vclk [get_ports sel_9]
set_input_delay 0.09 -clock vclk [get_ports sel_10]
set_input_delay 0.042 -clock vclk [get_ports sel_11]
set_input_delay 0.051 -clock vclk [get_ports sel_12]
set_input_delay 0.06 -clock vclk [get_ports sel_13]
