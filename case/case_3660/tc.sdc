create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.36 -clock vclk [get_ports sel_1]
set_input_delay 0.324 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.325 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.353 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.354 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.35 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.331 -clock vclk [get_ports sel_4]
set_input_delay 0.339 -clock vclk [get_ports sel_5]
set_input_delay 0.325 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.352 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.367 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.343 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.356 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.355 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.343 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.339 -clock vclk [get_ports sel_9]
