create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.228 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.233 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.196 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.211 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.188 -clock vclk [get_ports sel_3[2]]
