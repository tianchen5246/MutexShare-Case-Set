create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.174 -clock vclk [get_ports sel_1]
set_input_delay 0.183 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.187 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.24 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.15 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.139 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.228 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.157 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.132 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.138 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.19 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.146 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.148 -clock vclk [get_ports sel_7]
set_input_delay 0.176 -clock vclk [get_ports sel_8]
