create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.094 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.326 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.198 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.149 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.229 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.326 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.328 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.3 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.172 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.083 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.282 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.137 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.21 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.07 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.166 -clock vclk [get_ports sel_8[1]]
