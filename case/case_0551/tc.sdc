create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.162 -clock vclk [get_ports sel_1]
set_input_delay 0.178 -clock vclk [get_ports sel_2]
set_input_delay 0.169 -clock vclk [get_ports sel_3]
set_input_delay 0.185 -clock vclk [get_ports sel_4]
set_input_delay 0.16 -clock vclk [get_ports sel_5]
set_input_delay 0.102 -clock vclk [get_ports sel_6]
set_input_delay 0.091 -clock vclk [get_ports sel_7]
set_input_delay 0.157 -clock vclk [get_ports sel_8]
set_input_delay 0.082 -clock vclk [get_ports sel_9]
set_input_delay 0.151 -clock vclk [get_ports sel_10]
set_input_delay 0.161 -clock vclk [get_ports sel_11]
set_input_delay 0.095 -clock vclk [get_ports sel_12]
set_input_delay 0.084 -clock vclk [get_ports sel_13]
set_input_delay 0.124 -clock vclk [get_ports sel_14]
