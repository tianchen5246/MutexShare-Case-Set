create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.215 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.343 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_2]
set_input_delay 0.192 -clock vclk [get_ports sel_3]
set_input_delay 0.183 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.29 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.286 -clock vclk [get_ports sel_5]
set_input_delay 0.293 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.338 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.312 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.311 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.328 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.297 -clock vclk [get_ports sel_9]
set_input_delay 0.325 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.169 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.255 -clock vclk [get_ports sel_11]
