create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.206 -clock vclk [get_ports sel_1]
set_input_delay 0.228 -clock vclk [get_ports sel_2]
set_input_delay 0.196 -clock vclk [get_ports sel_3]
set_input_delay 0.212 -clock vclk [get_ports sel_4]
set_input_delay 0.268 -clock vclk [get_ports sel_5]
set_input_delay 0.208 -clock vclk [get_ports sel_6]
set_input_delay 0.284 -clock vclk [get_ports sel_7]
set_input_delay 0.243 -clock vclk [get_ports sel_8]
set_input_delay 0.212 -clock vclk [get_ports sel_9]
set_input_delay 0.167 -clock vclk [get_ports sel_10]
set_input_delay 0.277 -clock vclk [get_ports sel_11]
set_input_delay 0.136 -clock vclk [get_ports sel_12]
set_input_delay 0.179 -clock vclk [get_ports sel_13]
