create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.056 -clock vclk [get_ports sel_1]
set_input_delay 0.102 -clock vclk [get_ports sel_2]
set_input_delay 0.142 -clock vclk [get_ports sel_3]
set_input_delay 0.094 -clock vclk [get_ports sel_4]
set_input_delay 0.116 -clock vclk [get_ports sel_5]
set_input_delay 0.068 -clock vclk [get_ports sel_6]
set_input_delay 0.127 -clock vclk [get_ports sel_7]
set_input_delay 0.106 -clock vclk [get_ports sel_8]
set_input_delay 0.11 -clock vclk [get_ports sel_9]
set_input_delay 0.095 -clock vclk [get_ports sel_10]
