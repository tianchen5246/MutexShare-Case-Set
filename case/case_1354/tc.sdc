create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.124 -clock vclk [get_ports sel_1]
set_input_delay 0.117 -clock vclk [get_ports sel_2]
set_input_delay 0.222 -clock vclk [get_ports sel_3]
set_input_delay 0.075 -clock vclk [get_ports sel_4]
set_input_delay 0.167 -clock vclk [get_ports sel_5]
set_input_delay 0.104 -clock vclk [get_ports sel_6]
set_input_delay 0.164 -clock vclk [get_ports sel_7]
set_input_delay 0.173 -clock vclk [get_ports sel_8]
set_input_delay 0.103 -clock vclk [get_ports sel_9]
set_input_delay 0.09 -clock vclk [get_ports sel_10]
set_input_delay 0.125 -clock vclk [get_ports sel_11]
set_input_delay 0.093 -clock vclk [get_ports sel_12]
