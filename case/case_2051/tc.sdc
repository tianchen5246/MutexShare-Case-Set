create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.274 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.156 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.156 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.233 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.242 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.13 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.169 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.318 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.196 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.195 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.234 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.105 -clock vclk [get_ports sel_8[0]]
