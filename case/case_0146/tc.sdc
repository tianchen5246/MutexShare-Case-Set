create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.041 -clock vclk [get_ports sel_1]
set_input_delay 0.068 -clock vclk [get_ports sel_2]
set_input_delay 0.075 -clock vclk [get_ports sel_3]
set_input_delay 0.036 -clock vclk [get_ports sel_4]
set_input_delay 0.079 -clock vclk [get_ports sel_5]
set_input_delay 0.069 -clock vclk [get_ports sel_6]
set_input_delay 0.078 -clock vclk [get_ports sel_7]
set_input_delay 0.085 -clock vclk [get_ports sel_8]
set_input_delay 0.057 -clock vclk [get_ports sel_9]
