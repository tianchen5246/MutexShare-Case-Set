create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.2 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.059 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.074 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.102 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.091 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.087 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.124 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.158 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.088 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.186 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.045 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.058 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.126 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.077 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.1 -clock vclk [get_ports sel_8[1]]
