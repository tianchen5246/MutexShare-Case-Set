create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.272 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.33 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.217 -clock vclk [get_ports sel_2]
set_input_delay 0.223 -clock vclk [get_ports sel_3]
set_input_delay 0.227 -clock vclk [get_ports sel_4]
set_input_delay 0.26 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.33 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.361 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.33 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.328 -clock vclk [get_ports sel_7]
