create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.022 -clock vclk [get_ports sel_1]
set_input_delay 0.02 -clock vclk [get_ports sel_2]
set_input_delay 0.018 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.016 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.016 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.016 -clock vclk [get_ports sel_4]
set_input_delay 0.023 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.013 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.018 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.017 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.013 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.016 -clock vclk [get_ports sel_6[2]]
