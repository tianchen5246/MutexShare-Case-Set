create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.074 -clock vclk [get_ports sel_1]
set_input_delay 0.067 -clock vclk [get_ports sel_2]
set_input_delay 0.055 -clock vclk [get_ports sel_3]
set_input_delay 0.085 -clock vclk [get_ports sel_4]
set_input_delay 0.07 -clock vclk [get_ports sel_5]
set_input_delay 0.071 -clock vclk [get_ports sel_6]
set_input_delay 0.092 -clock vclk [get_ports sel_7]
set_input_delay 0.045 -clock vclk [get_ports sel_8]
set_input_delay 0.077 -clock vclk [get_ports sel_9]
set_input_delay 0.068 -clock vclk [get_ports sel_10]
set_input_delay 0.071 -clock vclk [get_ports sel_11]
set_input_delay 0.058 -clock vclk [get_ports sel_12]
set_input_delay 0.068 -clock vclk [get_ports sel_13]
