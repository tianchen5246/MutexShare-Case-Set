create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.308 -clock vclk [get_ports sel_1]
set_input_delay 0.272 -clock vclk [get_ports sel_2]
set_input_delay 0.266 -clock vclk [get_ports sel_3]
set_input_delay 0.222 -clock vclk [get_ports sel_4]
set_input_delay 0.174 -clock vclk [get_ports sel_5]
set_input_delay 0.358 -clock vclk [get_ports sel_6]
set_input_delay 0.357 -clock vclk [get_ports sel_7]
set_input_delay 0.157 -clock vclk [get_ports sel_8]
set_input_delay 0.232 -clock vclk [get_ports sel_9]
set_input_delay 0.358 -clock vclk [get_ports sel_10]
