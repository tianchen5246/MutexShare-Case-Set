create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.107 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.152 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.074 -clock vclk [get_ports sel_2]
set_input_delay 0.183 -clock vclk [get_ports sel_3]
set_input_delay 0.17 -clock vclk [get_ports sel_4]
set_input_delay 0.222 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.251 -clock vclk [get_ports sel_6]
set_input_delay 0.09 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.214 -clock vclk [get_ports sel_7[1]]
