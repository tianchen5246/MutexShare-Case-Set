create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.167 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.149 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.281 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.306 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.203 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.279 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.212 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.259 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.287 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.256 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.177 -clock vclk [get_ports sel_7[1]]
