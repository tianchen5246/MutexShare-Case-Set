create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.04 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.044 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.049 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.052 -clock vclk [get_ports sel_2]
set_input_delay 0.04 -clock vclk [get_ports sel_3]
set_input_delay 0.045 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.054 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.04 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.055 -clock vclk [get_ports sel_5]
