create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.15 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.256 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.141 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.135 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.285 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.126 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_3[2]]
