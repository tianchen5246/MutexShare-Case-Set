create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.161 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.134 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.117 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.14 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.122 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.141 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.139 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.135 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.142 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.159 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_7[1]]
