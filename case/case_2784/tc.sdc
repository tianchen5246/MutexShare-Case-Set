create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.233 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.28 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.244 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.221 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.242 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.206 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.273 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.208 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.19 -clock vclk [get_ports sel_4[1]]
