create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.278 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.286 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.281 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.283 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.286 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.285 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.29 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.285 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.295 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.288 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.286 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.29 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.291 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.277 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.282 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.293 -clock vclk [get_ports sel_8[1]]
