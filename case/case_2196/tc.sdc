create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.161 -clock vclk [get_ports sel_1]
set_input_delay 0.299 -clock vclk [get_ports sel_2]
set_input_delay 0.284 -clock vclk [get_ports sel_3]
set_input_delay 0.361 -clock vclk [get_ports sel_4]
set_input_delay 0.272 -clock vclk [get_ports sel_5]
set_input_delay 0.318 -clock vclk [get_ports sel_6]
set_input_delay 0.239 -clock vclk [get_ports sel_7]
set_input_delay 0.167 -clock vclk [get_ports sel_8]
set_input_delay 0.273 -clock vclk [get_ports sel_9]
