create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.085 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.214 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.137 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.107 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.111 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.132 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.2 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.187 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.166 -clock vclk [get_ports sel_3[2]]
