create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.382 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.34 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.315 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.366 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.354 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.375 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.371 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.314 -clock vclk [get_ports sel_4[1]]
