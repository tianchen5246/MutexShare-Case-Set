create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.057 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.072 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.081 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.086 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.057 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.073 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.043 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.049 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.098 -clock vclk [get_ports sel_5[1]]
