create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.331 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.297 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.351 -clock vclk [get_ports sel_2]
set_input_delay 0.33 -clock vclk [get_ports sel_3]
set_input_delay 0.33 -clock vclk [get_ports sel_4]
set_input_delay 0.328 -clock vclk [get_ports sel_5]
set_input_delay 0.314 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.35 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.358 -clock vclk [get_ports sel_7]
set_input_delay 0.324 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.324 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.344 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.321 -clock vclk [get_ports sel_9[1]]
