set_input_delay 0.168 -clock vclk [get_ports sel_8]
set_input_delay 0.076 -clock vclk [get_ports sel_9]
set_input_delay 0.126 -clock vclk [get_ports sel_10]
set_input_delay 0.197 -clock vclk [get_ports sel_11]
