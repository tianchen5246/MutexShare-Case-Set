create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.133 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.158 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.185 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.165 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.21 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.174 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.136 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.17 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.18 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.187 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.193 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_5[2]]
