create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.323 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.332 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.31 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.32 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.327 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.306 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.329 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.307 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.335 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.325 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.331 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.303 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.34 -clock vclk [get_ports sel_6[1]]
