create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.246 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.202 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.223 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.191 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.178 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.247 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.199 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.178 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.245 -clock vclk [get_ports sel_4[2]]
