create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.045 -clock vclk [get_ports sel_1]
set_input_delay 0.081 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.064 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.04 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.043 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.063 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.077 -clock vclk [get_ports sel_4]
set_input_delay 0.051 -clock vclk [get_ports sel_5]
set_input_delay 0.052 -clock vclk [get_ports sel_6]
set_input_delay 0.055 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.086 -clock vclk [get_ports sel_7[1]]
