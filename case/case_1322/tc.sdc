create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.102 -clock vclk [get_ports sel_1]
set_input_delay 0.083 -clock vclk [get_ports sel_2]
set_input_delay 0.111 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.106 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.115 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.119 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.084 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.087 -clock vclk [get_ports sel_5]
set_input_delay 0.101 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.123 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.085 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.107 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.122 -clock vclk [get_ports sel_8]
set_input_delay 0.115 -clock vclk [get_ports sel_9]
set_input_delay 0.097 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.093 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.086 -clock vclk [get_ports sel_11]
