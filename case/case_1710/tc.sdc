set_input_delay 0.037 -clock vclk [get_ports sel_5]
set_input_delay 0.26 -clock vclk [get_ports sel_6]
set_input_delay 0.269 -clock vclk [get_ports sel_7]
set_input_delay 0.04 -clock vclk [get_ports sel_8]
set_input_delay 0.225 -clock vclk [get_ports sel_9]
set_input_delay 0.278 -clock vclk [get_ports sel_10]
set_input_delay 0.059 -clock vclk [get_ports sel_11]
set_input_delay 0.296 -clock vclk [get_ports sel_12]
set_input_delay 0.128 -clock vclk [get_ports sel_13]
set_input_delay 0.284 -clock vclk [get_ports sel_14]
