create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.094 -clock vclk [get_ports sel_1]
set_input_delay 0.209 -clock vclk [get_ports sel_2]
set_input_delay 0.23 -clock vclk [get_ports sel_3]
set_input_delay 0.081 -clock vclk [get_ports sel_4]
set_input_delay 0.141 -clock vclk [get_ports sel_5]
set_input_delay 0.205 -clock vclk [get_ports sel_6]
set_input_delay 0.121 -clock vclk [get_ports sel_7]
set_input_delay 0.168 -clock vclk [get_ports sel_8]
set_input_delay 0.286 -clock vclk [get_ports sel_9]
set_input_delay 0.185 -clock vclk [get_ports sel_10]
set_input_delay 0.184 -clock vclk [get_ports sel_11]
set_input_delay 0.178 -clock vclk [get_ports sel_12]
