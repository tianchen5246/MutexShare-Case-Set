set_input_delay 0.161 -clock vclk [get_ports sel_6]
set_input_delay 0.129 -clock vclk [get_ports sel_7]
set_input_delay 0.208 -clock vclk [get_ports sel_8]
set_input_delay 0.18 -clock vclk [get_ports sel_9]
set_input_delay 0.272 -clock vclk [get_ports sel_10]
set_input_delay 0.178 -clock vclk [get_ports sel_11]
set_input_delay 0.198 -clock vclk [get_ports sel_12]
