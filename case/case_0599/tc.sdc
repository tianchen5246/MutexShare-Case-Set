create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.264 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.195 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.178 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.262 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.245 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.229 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.273 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.255 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.276 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.26 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.17 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.229 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.26 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.165 -clock vclk [get_ports sel_7[1]]
