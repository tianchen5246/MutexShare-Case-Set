create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.125 -clock vclk [get_ports sel_1]
set_input_delay 0.128 -clock vclk [get_ports sel_2]
set_input_delay 0.115 -clock vclk [get_ports sel_3]
set_input_delay 0.151 -clock vclk [get_ports sel_4]
set_input_delay 0.145 -clock vclk [get_ports sel_5]
set_input_delay 0.106 -clock vclk [get_ports sel_6]
set_input_delay 0.141 -clock vclk [get_ports sel_7]
set_input_delay 0.112 -clock vclk [get_ports sel_8]
set_input_delay 0.121 -clock vclk [get_ports sel_9]
set_input_delay 0.141 -clock vclk [get_ports sel_10]
set_input_delay 0.127 -clock vclk [get_ports sel_11]
set_input_delay 0.146 -clock vclk [get_ports sel_12]
set_input_delay 0.14 -clock vclk [get_ports sel_13]
set_input_delay 0.143 -clock vclk [get_ports sel_14]
