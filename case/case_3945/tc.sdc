create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.206 -clock vclk [get_ports sel_1]
set_input_delay 0.184 -clock vclk [get_ports sel_2]
set_input_delay 0.229 -clock vclk [get_ports sel_3]
set_input_delay 0.144 -clock vclk [get_ports sel_4]
set_input_delay 0.239 -clock vclk [get_ports sel_5]
set_input_delay 0.154 -clock vclk [get_ports sel_6]
set_input_delay 0.264 -clock vclk [get_ports sel_7]
set_input_delay 0.201 -clock vclk [get_ports sel_8]
set_input_delay 0.204 -clock vclk [get_ports sel_9]
set_input_delay 0.261 -clock vclk [get_ports sel_10]
