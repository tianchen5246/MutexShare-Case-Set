create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.245 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.225 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.248 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.254 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.243 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.231 -clock vclk [get_ports sel_3]
set_input_delay 0.242 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.24 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.246 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.236 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.217 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.219 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.218 -clock vclk [get_ports sel_6[2]]
