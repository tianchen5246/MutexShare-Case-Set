set_input_delay 0.284 -clock vclk [get_ports sel_6]
set_input_delay 0.221 -clock vclk [get_ports sel_7]
set_input_delay 0.179 -clock vclk [get_ports sel_8]
set_input_delay 0.284 -clock vclk [get_ports sel_9]
set_input_delay 0.303 -clock vclk [get_ports sel_10]
set_input_delay 0.151 -clock vclk [get_ports sel_11]
set_input_delay 0.302 -clock vclk [get_ports sel_12]
set_input_delay 0.243 -clock vclk [get_ports sel_13]
set_input_delay 0.232 -clock vclk [get_ports sel_14]
