create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.198 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.315 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.312 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.203 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.287 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.325 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.323 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.265 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.238 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.291 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.284 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.305 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.207 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.227 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.285 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.283 -clock vclk [get_ports sel_8[1]]
