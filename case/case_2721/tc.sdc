create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.235 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.205 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.224 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.231 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.193 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.238 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.238 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.166 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.231 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.187 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_7[1]]
