create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.096 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.14 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.081 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.133 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.141 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.119 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.149 -clock vclk [get_ports sel_3[2]]
