set_input_delay 0.063 -clock vclk [get_ports sel_8]
set_input_delay 0.082 -clock vclk [get_ports sel_9]
set_input_delay 0.056 -clock vclk [get_ports sel_10]
set_input_delay 0.061 -clock vclk [get_ports sel_11]
