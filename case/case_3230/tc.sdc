create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.249 -clock vclk [get_ports sel_1]
set_input_delay 0.223 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.223 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.206 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.195 -clock vclk [get_ports sel_4]
