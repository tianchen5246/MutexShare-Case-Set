create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.073 -clock vclk [get_ports sel_1]
set_input_delay 0.106 -clock vclk [get_ports sel_2]
set_input_delay 0.109 -clock vclk [get_ports sel_3]
set_input_delay 0.215 -clock vclk [get_ports sel_4]
set_input_delay 0.099 -clock vclk [get_ports sel_5]
set_input_delay 0.232 -clock vclk [get_ports sel_6]
set_input_delay 0.224 -clock vclk [get_ports sel_7]
set_input_delay 0.163 -clock vclk [get_ports sel_8]
set_input_delay 0.136 -clock vclk [get_ports sel_9]
set_input_delay 0.164 -clock vclk [get_ports sel_10]
set_input_delay 0.25 -clock vclk [get_ports sel_11]
set_input_delay 0.077 -clock vclk [get_ports sel_12]
set_input_delay 0.181 -clock vclk [get_ports sel_13]
set_input_delay 0.076 -clock vclk [get_ports sel_14]
