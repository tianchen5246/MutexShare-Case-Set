set_input_delay 0.337 -clock vclk [get_ports sel_8]
set_input_delay 0.342 -clock vclk [get_ports sel_9]
set_input_delay 0.31 -clock vclk [get_ports sel_10]
set_input_delay 0.358 -clock vclk [get_ports sel_11]
set_input_delay 0.341 -clock vclk [get_ports sel_12]
