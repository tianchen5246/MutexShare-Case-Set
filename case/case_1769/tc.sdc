create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.16 -clock vclk [get_ports sel_1]
set_input_delay 0.22 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.193 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.13 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.213 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.222 -clock vclk [get_ports sel_4]
set_input_delay 0.196 -clock vclk [get_ports sel_5]
