set_input_delay 0.287 -clock vclk [get_ports sel_5]
set_input_delay 0.29 -clock vclk [get_ports sel_6]
set_input_delay 0.253 -clock vclk [get_ports sel_7]
set_input_delay 0.302 -clock vclk [get_ports sel_8]
set_input_delay 0.298 -clock vclk [get_ports sel_9]
set_input_delay 0.248 -clock vclk [get_ports sel_10]
set_input_delay 0.248 -clock vclk [get_ports sel_11]
set_input_delay 0.318 -clock vclk [get_ports sel_12]
set_input_delay 0.315 -clock vclk [get_ports sel_13]
