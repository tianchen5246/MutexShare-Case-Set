create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.111 -clock vclk [get_ports sel_1]
set_input_delay 0.145 -clock vclk [get_ports sel_2]
set_input_delay 0.129 -clock vclk [get_ports sel_3]
set_input_delay 0.163 -clock vclk [get_ports sel_4]
set_input_delay 0.122 -clock vclk [get_ports sel_5]
set_input_delay 0.145 -clock vclk [get_ports sel_6]
set_input_delay 0.277 -clock vclk [get_ports sel_7]
set_input_delay 0.227 -clock vclk [get_ports sel_8]
set_input_delay 0.095 -clock vclk [get_ports sel_9]
set_input_delay 0.232 -clock vclk [get_ports sel_10]
set_input_delay 0.331 -clock vclk [get_ports sel_11]
set_input_delay 0.097 -clock vclk [get_ports sel_12]
