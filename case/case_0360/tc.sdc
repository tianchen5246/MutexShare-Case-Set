create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.355 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.324 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.337 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.346 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.357 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.35 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.331 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.353 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.372 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.374 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.344 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.34 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.375 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.329 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.335 -clock vclk [get_ports sel_7[1]]
