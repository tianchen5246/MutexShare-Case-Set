set_input_delay 0.17 -clock vclk [get_ports sel_6]
set_input_delay 0.081 -clock vclk [get_ports sel_7]
set_input_delay 0.206 -clock vclk [get_ports sel_8]
set_input_delay 0.302 -clock vclk [get_ports sel_9]
set_input_delay 0.081 -clock vclk [get_ports sel_10]
set_input_delay 0.141 -clock vclk [get_ports sel_11]
set_input_delay 0.066 -clock vclk [get_ports sel_12]
