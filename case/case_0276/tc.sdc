create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.255 -clock vclk [get_ports sel_1]
set_input_delay 0.296 -clock vclk [get_ports sel_2]
set_input_delay 0.186 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.214 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.342 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.289 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.175 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.313 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.263 -clock vclk [get_ports sel_6]
set_input_delay 0.289 -clock vclk [get_ports sel_7]
set_input_delay 0.24 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.168 -clock vclk [get_ports sel_8[1]]
