create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.16 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.29 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.237 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.267 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.216 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.301 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.3 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.173 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.19 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.244 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.174 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.203 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.267 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.165 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.234 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.128 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.138 -clock vclk [get_ports sel_7[1]]
