create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.151 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.267 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.054 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.051 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.074 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.314 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.052 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.117 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.335 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.122 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.173 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.096 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.197 -clock vclk [get_ports sel_5[2]]
