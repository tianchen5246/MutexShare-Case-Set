create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.267 -clock vclk [get_ports sel_1]
set_input_delay 0.228 -clock vclk [get_ports sel_2]
set_input_delay 0.255 -clock vclk [get_ports sel_3]
set_input_delay 0.292 -clock vclk [get_ports sel_4]
set_input_delay 0.24 -clock vclk [get_ports sel_5]
set_input_delay 0.303 -clock vclk [get_ports sel_6]
set_input_delay 0.228 -clock vclk [get_ports sel_7]
set_input_delay 0.199 -clock vclk [get_ports sel_8]
set_input_delay 0.196 -clock vclk [get_ports sel_9]
