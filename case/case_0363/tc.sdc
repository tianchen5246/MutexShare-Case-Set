set_input_delay 0.394 -clock vclk [get_ports sel_6]
set_input_delay 0.308 -clock vclk [get_ports sel_7]
set_input_delay 0.02 -clock vclk [get_ports sel_8]
set_input_delay 0.201 -clock vclk [get_ports sel_9]
set_input_delay 0.149 -clock vclk [get_ports sel_10]
set_input_delay 0.021 -clock vclk [get_ports sel_11]
set_input_delay 0.272 -clock vclk [get_ports sel_12]
