create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.036 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.078 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.115 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.134 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.077 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.112 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_3[2]]
