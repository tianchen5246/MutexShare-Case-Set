create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.371 -clock vclk [get_ports sel_1]
set_input_delay 0.353 -clock vclk [get_ports sel_2]
set_input_delay 0.37 -clock vclk [get_ports sel_3]
set_input_delay 0.353 -clock vclk [get_ports sel_4]
set_input_delay 0.354 -clock vclk [get_ports sel_5]
set_input_delay 0.337 -clock vclk [get_ports sel_6]
set_input_delay 0.364 -clock vclk [get_ports sel_7]
set_input_delay 0.364 -clock vclk [get_ports sel_8]
set_input_delay 0.36 -clock vclk [get_ports sel_9]
set_input_delay 0.368 -clock vclk [get_ports sel_10]
