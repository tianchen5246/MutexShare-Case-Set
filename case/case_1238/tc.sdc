set_input_delay 0.143 -clock vclk [get_ports sel_7]
set_input_delay 0.14 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.15 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.092 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.098 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.149 -clock vclk [get_ports sel_10]
