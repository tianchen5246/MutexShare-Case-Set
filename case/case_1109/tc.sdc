create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.165 -clock vclk [get_ports sel_1]
set_input_delay 0.187 -clock vclk [get_ports sel_2]
set_input_delay 0.147 -clock vclk [get_ports sel_3]
set_input_delay 0.072 -clock vclk [get_ports sel_4]
set_input_delay 0.258 -clock vclk [get_ports sel_5]
set_input_delay 0.069 -clock vclk [get_ports sel_6]
set_input_delay 0.252 -clock vclk [get_ports sel_7]
set_input_delay 0.093 -clock vclk [get_ports sel_8]
set_input_delay 0.115 -clock vclk [get_ports sel_9]
set_input_delay 0.26 -clock vclk [get_ports sel_10]
set_input_delay 0.141 -clock vclk [get_ports sel_11]
set_input_delay 0.07 -clock vclk [get_ports sel_12]
set_input_delay 0.107 -clock vclk [get_ports sel_13]
