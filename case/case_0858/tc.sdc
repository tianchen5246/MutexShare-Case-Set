create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.354 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.385 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.358 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.376 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.366 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.393 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.383 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.389 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.362 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.375 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.381 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.347 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.361 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.343 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.338 -clock vclk [get_ports sel_5[2]]
