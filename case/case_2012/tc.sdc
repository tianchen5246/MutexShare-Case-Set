set_input_delay 0.157 -clock vclk [get_ports sel_6]
set_input_delay 0.19 -clock vclk [get_ports sel_7]
set_input_delay 0.054 -clock vclk [get_ports sel_8]
set_input_delay 0.199 -clock vclk [get_ports sel_9]
set_input_delay 0.292 -clock vclk [get_ports sel_10]
set_input_delay 0.063 -clock vclk [get_ports sel_11]
set_input_delay 0.216 -clock vclk [get_ports sel_12]
