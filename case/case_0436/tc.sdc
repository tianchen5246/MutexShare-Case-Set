create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.004 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.055 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.042 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.007 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.034 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.053 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.044 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.017 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.01 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.037 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.043 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.033 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.018 -clock vclk [get_ports sel_6[1]]
