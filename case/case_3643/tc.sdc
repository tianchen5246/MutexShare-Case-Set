create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.128 -clock vclk [get_ports sel_1]
set_input_delay 0.101 -clock vclk [get_ports sel_2]
set_input_delay 0.174 -clock vclk [get_ports sel_3]
set_input_delay 0.181 -clock vclk [get_ports sel_4]
set_input_delay 0.057 -clock vclk [get_ports sel_5]
set_input_delay 0.165 -clock vclk [get_ports sel_6]
set_input_delay 0.104 -clock vclk [get_ports sel_7]
set_input_delay 0.162 -clock vclk [get_ports sel_8]
set_input_delay 0.093 -clock vclk [get_ports sel_9]
set_input_delay 0.099 -clock vclk [get_ports sel_10]
