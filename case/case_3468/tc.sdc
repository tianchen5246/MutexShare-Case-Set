create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.345 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.274 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.334 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.175 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.108 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.336 -clock vclk [get_ports sel_3[2]]
