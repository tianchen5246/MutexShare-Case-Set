create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.157 -clock vclk [get_ports sel_1]
set_input_delay 0.126 -clock vclk [get_ports sel_2]
set_input_delay 0.168 -clock vclk [get_ports sel_3]
set_input_delay 0.17 -clock vclk [get_ports sel_4]
set_input_delay 0.145 -clock vclk [get_ports sel_5]
set_input_delay 0.14 -clock vclk [get_ports sel_6]
set_input_delay 0.145 -clock vclk [get_ports sel_7]
set_input_delay 0.144 -clock vclk [get_ports sel_8]
set_input_delay 0.164 -clock vclk [get_ports sel_9]
set_input_delay 0.155 -clock vclk [get_ports sel_10]
set_input_delay 0.148 -clock vclk [get_ports sel_11]
set_input_delay 0.15 -clock vclk [get_ports sel_12]
set_input_delay 0.141 -clock vclk [get_ports sel_13]
