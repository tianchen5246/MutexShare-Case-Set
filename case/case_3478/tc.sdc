set_input_delay 0.078 -clock vclk [get_ports sel_5]
set_input_delay 0.103 -clock vclk [get_ports sel_6]
set_input_delay 0.059 -clock vclk [get_ports sel_7]
set_input_delay 0.08 -clock vclk [get_ports sel_8]
set_input_delay 0.085 -clock vclk [get_ports sel_9]
set_input_delay 0.094 -clock vclk [get_ports sel_10]
set_input_delay 0.06 -clock vclk [get_ports sel_11]
set_input_delay 0.036 -clock vclk [get_ports sel_12]
set_input_delay 0.099 -clock vclk [get_ports sel_13]
set_input_delay 0.029 -clock vclk [get_ports sel_14]
