create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.187 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.141 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.115 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.113 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.237 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.214 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.16 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.117 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.126 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.123 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.199 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.245 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.119 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.224 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.139 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.119 -clock vclk [get_ports sel_8[1]]
