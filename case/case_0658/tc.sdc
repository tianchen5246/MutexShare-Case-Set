create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.364 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.251 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.221 -clock vclk [get_ports sel_2]
set_input_delay 0.322 -clock vclk [get_ports sel_3]
set_input_delay 0.264 -clock vclk [get_ports sel_4]
set_input_delay 0.323 -clock vclk [get_ports sel_5]
set_input_delay 0.327 -clock vclk [get_ports sel_6]
set_input_delay 0.352 -clock vclk [get_ports sel_7]
set_input_delay 0.284 -clock vclk [get_ports sel_8]
set_input_delay 0.345 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.309 -clock vclk [get_ports sel_9[1]]
