create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.297 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.282 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.334 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.372 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.279 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.36 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.288 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.281 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.314 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.322 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.315 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.327 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.302 -clock vclk [get_ports sel_5[2]]
