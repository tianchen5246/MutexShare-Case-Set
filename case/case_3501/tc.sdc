create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.342 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.355 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.343 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.339 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.342 -clock vclk [get_ports sel_3]
set_input_delay 0.352 -clock vclk [get_ports sel_4]
set_input_delay 0.351 -clock vclk [get_ports sel_5]
set_input_delay 0.345 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.343 -clock vclk [get_ports sel_6[1]]
