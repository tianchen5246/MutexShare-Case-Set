create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.025 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.021 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.078 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.055 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.008 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.042 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.077 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.04 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.08 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.076 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.024 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.086 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.045 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.038 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.08 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.022 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.08 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.051 -clock vclk [get_ports sel_8[1]]
