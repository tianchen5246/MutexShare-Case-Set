create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.232 -clock vclk [get_ports sel_1]
set_input_delay 0.22 -clock vclk [get_ports sel_2]
set_input_delay 0.273 -clock vclk [get_ports sel_3]
set_input_delay 0.224 -clock vclk [get_ports sel_4]
set_input_delay 0.193 -clock vclk [get_ports sel_5]
set_input_delay 0.212 -clock vclk [get_ports sel_6]
set_input_delay 0.314 -clock vclk [get_ports sel_7]
set_input_delay 0.219 -clock vclk [get_ports sel_8]
set_input_delay 0.276 -clock vclk [get_ports sel_9]
set_input_delay 0.312 -clock vclk [get_ports sel_10]
set_input_delay 0.244 -clock vclk [get_ports sel_11]
set_input_delay 0.321 -clock vclk [get_ports sel_12]
