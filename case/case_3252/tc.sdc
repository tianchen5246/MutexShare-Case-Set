create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.143 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.141 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.098 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.082 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.154 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.098 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.079 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.158 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.127 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.12 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.153 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.08 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.148 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.103 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.079 -clock vclk [get_ports sel_8[1]]
