create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.391 -clock vclk [get_ports sel_1]
set_input_delay 0.394 -clock vclk [get_ports sel_2]
set_input_delay 0.394 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.398 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.395 -clock vclk [get_ports sel_4]
set_input_delay 0.392 -clock vclk [get_ports sel_5]
set_input_delay 0.391 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.397 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.395 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.395 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.394 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.392 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.394 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.395 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.393 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.391 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.392 -clock vclk [get_ports sel_11[0]]
set_input_delay 0.391 -clock vclk [get_ports sel_11[1]]
set_input_delay 0.399 -clock vclk [get_ports sel_12]
