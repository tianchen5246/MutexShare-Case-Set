create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.237 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.238 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.27 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.332 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.061 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.148 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.086 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.237 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.316 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.057 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.263 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.113 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.055 -clock vclk [get_ports sel_7[1]]
