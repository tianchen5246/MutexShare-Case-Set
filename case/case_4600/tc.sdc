create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.305 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.214 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.222 -clock vclk [get_ports sel_2]
set_input_delay 0.242 -clock vclk [get_ports sel_3]
set_input_delay 0.264 -clock vclk [get_ports sel_4]
set_input_delay 0.258 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.353 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.342 -clock vclk [get_ports sel_7]
set_input_delay 0.248 -clock vclk [get_ports sel_8]
set_input_delay 0.21 -clock vclk [get_ports sel_9]
set_input_delay 0.237 -clock vclk [get_ports sel_10]
set_input_delay 0.356 -clock vclk [get_ports sel_11]
set_input_delay 0.347 -clock vclk [get_ports sel_12[0]]
set_input_delay 0.189 -clock vclk [get_ports sel_12[1]]
