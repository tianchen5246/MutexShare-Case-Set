create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.364 -clock vclk [get_ports sel_1]
set_input_delay 0.388 -clock vclk [get_ports sel_2]
set_input_delay 0.346 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.359 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.378 -clock vclk [get_ports sel_4]
set_input_delay 0.354 -clock vclk [get_ports sel_5]
set_input_delay 0.348 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.367 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.384 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.348 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.345 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.358 -clock vclk [get_ports sel_8]
set_input_delay 0.345 -clock vclk [get_ports sel_9]
set_input_delay 0.388 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.347 -clock vclk [get_ports sel_10[1]]
