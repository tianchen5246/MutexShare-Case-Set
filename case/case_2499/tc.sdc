create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.169 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.181 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.144 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.209 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.213 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.25 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.171 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.154 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.206 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.192 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.191 -clock vclk [get_ports sel_4[2]]
