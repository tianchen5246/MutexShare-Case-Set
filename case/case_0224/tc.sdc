create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.373 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.376 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.379 -clock vclk [get_ports sel_2]
set_input_delay 0.377 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.372 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.369 -clock vclk [get_ports sel_4]
set_input_delay 0.378 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.372 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.369 -clock vclk [get_ports sel_6]
set_input_delay 0.369 -clock vclk [get_ports sel_7]
set_input_delay 0.372 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.374 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.375 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.374 -clock vclk [get_ports sel_9[1]]
