create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.157 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.202 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.354 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.313 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.301 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.236 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.13 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.316 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.13 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.257 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.341 -clock vclk [get_ports sel_7[1]]
