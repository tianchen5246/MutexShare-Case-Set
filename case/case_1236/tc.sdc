create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.11 -clock vclk [get_ports sel_1]
set_input_delay 0.146 -clock vclk [get_ports sel_2]
set_input_delay 0.095 -clock vclk [get_ports sel_3]
set_input_delay 0.116 -clock vclk [get_ports sel_4]
set_input_delay 0.041 -clock vclk [get_ports sel_5]
set_input_delay 0.103 -clock vclk [get_ports sel_6]
set_input_delay 0.155 -clock vclk [get_ports sel_7]
set_input_delay 0.067 -clock vclk [get_ports sel_8]
set_input_delay 0.106 -clock vclk [get_ports sel_9]
set_input_delay 0.085 -clock vclk [get_ports sel_10]
set_input_delay 0.145 -clock vclk [get_ports sel_11]
set_input_delay 0.132 -clock vclk [get_ports sel_12]
