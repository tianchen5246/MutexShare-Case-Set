create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.225 -clock vclk [get_ports sel_1]
set_input_delay 0.303 -clock vclk [get_ports sel_2]
set_input_delay 0.276 -clock vclk [get_ports sel_3]
set_input_delay 0.296 -clock vclk [get_ports sel_4]
set_input_delay 0.082 -clock vclk [get_ports sel_5]
set_input_delay 0.124 -clock vclk [get_ports sel_6]
set_input_delay 0.078 -clock vclk [get_ports sel_7]
set_input_delay 0.227 -clock vclk [get_ports sel_8]
