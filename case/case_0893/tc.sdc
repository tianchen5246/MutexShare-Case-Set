create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.196 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.195 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.2 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.139 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.137 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.215 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.189 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.177 -clock vclk [get_ports sel_4[2]]
