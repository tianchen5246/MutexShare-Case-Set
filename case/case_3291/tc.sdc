create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.163 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.132 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.251 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.248 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.282 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.209 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.114 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.337 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.325 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.257 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.297 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.33 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.113 -clock vclk [get_ports sel_5[2]]
