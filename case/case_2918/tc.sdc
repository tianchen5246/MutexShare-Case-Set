create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.266 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.139 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.248 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.16 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.218 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.189 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.18 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.305 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.148 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.345 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.35 -clock vclk [get_ports sel_7[1]]
