create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.197 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.302 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.203 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.279 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.1 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.22 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.247 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.211 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.247 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.256 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.321 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.187 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.24 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.134 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.126 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.277 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.343 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.262 -clock vclk [get_ports sel_6[2]]
