create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.18 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.119 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.081 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.163 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.085 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.061 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.143 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.127 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.087 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.165 -clock vclk [get_ports sel_5[1]]
