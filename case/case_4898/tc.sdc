create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.15 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.064 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.055 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.045 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.131 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.097 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.083 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.13 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.189 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.212 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.274 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.128 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.145 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.202 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.041 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.066 -clock vclk [get_ports sel_6[2]]
