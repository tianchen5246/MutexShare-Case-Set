create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.375 -clock vclk [get_ports sel_1]
set_input_delay 0.354 -clock vclk [get_ports sel_2]
set_input_delay 0.349 -clock vclk [get_ports sel_3]
set_input_delay 0.373 -clock vclk [get_ports sel_4]
set_input_delay 0.355 -clock vclk [get_ports sel_5]
set_input_delay 0.36 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.354 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.359 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.344 -clock vclk [get_ports sel_7]
set_input_delay 0.362 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.377 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.353 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.341 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.376 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.377 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.377 -clock vclk [get_ports sel_11[0]]
set_input_delay 0.373 -clock vclk [get_ports sel_11[1]]
set_input_delay 0.352 -clock vclk [get_ports sel_12]
set_input_delay 0.37 -clock vclk [get_ports sel_13]
