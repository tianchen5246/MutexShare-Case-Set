create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.174 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.145 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.138 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.133 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.18 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.138 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.151 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.145 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.146 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.156 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.157 -clock vclk [get_ports sel_5[2]]
