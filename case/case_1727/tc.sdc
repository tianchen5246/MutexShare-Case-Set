create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.192 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.224 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.246 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.22 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.135 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.147 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.179 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.157 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.232 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.202 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.206 -clock vclk [get_ports sel_5[2]]
