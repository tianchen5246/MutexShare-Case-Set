create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.115 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.123 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.119 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.116 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.112 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.117 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.126 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.107 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.105 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.121 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.122 -clock vclk [get_ports sel_4[2]]
