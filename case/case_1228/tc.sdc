create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.302 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.295 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.296 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.295 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.303 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.294 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.304 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.299 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.297 -clock vclk [get_ports sel_3[2]]
