create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.041 -clock vclk [get_ports sel_1]
set_input_delay 0.04 -clock vclk [get_ports sel_2]
set_input_delay 0.04 -clock vclk [get_ports sel_3]
set_input_delay 0.051 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.015 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.037 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.016 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.03 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.037 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.053 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.009 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.044 -clock vclk [get_ports sel_7]
