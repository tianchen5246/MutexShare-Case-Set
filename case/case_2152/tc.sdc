create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.033 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.024 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.019 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.037 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.062 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.048 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.029 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.039 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.022 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.053 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.035 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.026 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.024 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.047 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.032 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.033 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.047 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.02 -clock vclk [get_ports sel_6[2]]
