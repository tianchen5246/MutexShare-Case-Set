create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.186 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.261 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.279 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.232 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.18 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.26 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.189 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.28 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.268 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_5[2]]
