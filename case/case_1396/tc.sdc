create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.096 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.147 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.206 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.143 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.189 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.062 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.149 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.096 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.197 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.081 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.165 -clock vclk [get_ports sel_6[1]]
