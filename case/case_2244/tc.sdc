create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.205 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.306 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.148 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.213 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.297 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.196 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.296 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.242 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.3 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.17 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.275 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.163 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.147 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.263 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.232 -clock vclk [get_ports sel_8[1]]
