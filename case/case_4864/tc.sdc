create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.049 -clock vclk [get_ports sel_1]
set_input_delay 0.121 -clock vclk [get_ports sel_2]
set_input_delay 0.25 -clock vclk [get_ports sel_3]
set_input_delay 0.085 -clock vclk [get_ports sel_4]
set_input_delay 0.289 -clock vclk [get_ports sel_5]
set_input_delay 0.013 -clock vclk [get_ports sel_6]
set_input_delay 0.186 -clock vclk [get_ports sel_7]
set_input_delay 0.167 -clock vclk [get_ports sel_8]
