set_input_delay 0.171 -clock vclk [get_ports sel_5]
set_input_delay 0.139 -clock vclk [get_ports sel_6]
set_input_delay 0.142 -clock vclk [get_ports sel_7]
set_input_delay 0.148 -clock vclk [get_ports sel_8]
set_input_delay 0.156 -clock vclk [get_ports sel_9]
set_input_delay 0.152 -clock vclk [get_ports sel_10]
set_input_delay 0.152 -clock vclk [get_ports sel_11]
set_input_delay 0.152 -clock vclk [get_ports sel_12]
set_input_delay 0.157 -clock vclk [get_ports sel_13]
set_input_delay 0.141 -clock vclk [get_ports sel_14]
