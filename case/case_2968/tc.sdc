create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.269 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.274 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.312 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.281 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.255 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.245 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.242 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.261 -clock vclk [get_ports sel_4[1]]
