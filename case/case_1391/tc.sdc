create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.037 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.031 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.108 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.197 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.076 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.173 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.097 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.027 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.117 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.032 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.168 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.152 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.181 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.206 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.082 -clock vclk [get_ports sel_8[1]]
