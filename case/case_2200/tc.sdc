create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.179 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.1 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.018 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.065 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.018 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.151 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.105 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.028 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.191 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.124 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.173 -clock vclk [get_ports sel_6[1]]
