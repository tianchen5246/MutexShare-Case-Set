create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.191 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.066 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.203 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.1 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.049 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.176 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.043 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.159 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.089 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.156 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.111 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.21 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.113 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.217 -clock vclk [get_ports sel_8[1]]
