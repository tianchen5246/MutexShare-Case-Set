set_input_delay 0.187 -clock vclk [get_ports sel_6]
set_input_delay 0.19 -clock vclk [get_ports sel_7]
set_input_delay 0.354 -clock vclk [get_ports sel_8]
set_input_delay 0.122 -clock vclk [get_ports sel_9]
set_input_delay 0.182 -clock vclk [get_ports sel_10]
set_input_delay 0.253 -clock vclk [get_ports sel_11]
set_input_delay 0.141 -clock vclk [get_ports sel_12]
set_input_delay 0.254 -clock vclk [get_ports sel_13]
set_input_delay 0.312 -clock vclk [get_ports sel_14]
