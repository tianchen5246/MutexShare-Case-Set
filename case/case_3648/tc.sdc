create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.248 -clock vclk [get_ports sel_1]
set_input_delay 0.285 -clock vclk [get_ports sel_2]
set_input_delay 0.157 -clock vclk [get_ports sel_3]
set_input_delay 0.322 -clock vclk [get_ports sel_4]
set_input_delay 0.16 -clock vclk [get_ports sel_5]
set_input_delay 0.087 -clock vclk [get_ports sel_6]
set_input_delay 0.237 -clock vclk [get_ports sel_7]
set_input_delay 0.191 -clock vclk [get_ports sel_8]
