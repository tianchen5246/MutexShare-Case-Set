create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.027 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.043 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.017 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.004 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.057 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.013 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.015 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.045 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.038 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.012 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.052 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.028 -clock vclk [get_ports sel_4[2]]
