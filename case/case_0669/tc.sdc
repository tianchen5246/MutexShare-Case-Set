set_input_delay 0.238 -clock vclk [get_ports sel_5]
set_input_delay 0.267 -clock vclk [get_ports sel_6]
set_input_delay 0.305 -clock vclk [get_ports sel_7]
set_input_delay 0.171 -clock vclk [get_ports sel_8]
set_input_delay 0.135 -clock vclk [get_ports sel_9]
set_input_delay 0.165 -clock vclk [get_ports sel_10]
set_input_delay 0.27 -clock vclk [get_ports sel_11]
set_input_delay 0.13 -clock vclk [get_ports sel_12]
set_input_delay 0.207 -clock vclk [get_ports sel_13]
