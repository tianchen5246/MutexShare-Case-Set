create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.198 -clock vclk [get_ports sel_1]
set_input_delay 0.018 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.322 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.165 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.325 -clock vclk [get_ports sel_3]
set_input_delay 0.031 -clock vclk [get_ports sel_4]
set_input_delay 0.218 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.05 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_6]
set_input_delay 0.295 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_7[1]]
