create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.193 -clock vclk [get_ports sel_1]
set_input_delay 0.163 -clock vclk [get_ports sel_2]
set_input_delay 0.128 -clock vclk [get_ports sel_3]
set_input_delay 0.102 -clock vclk [get_ports sel_4]
set_input_delay 0.142 -clock vclk [get_ports sel_5]
set_input_delay 0.258 -clock vclk [get_ports sel_6]
set_input_delay 0.112 -clock vclk [get_ports sel_7]
set_input_delay 0.219 -clock vclk [get_ports sel_8]
set_input_delay 0.105 -clock vclk [get_ports sel_9]
set_input_delay 0.208 -clock vclk [get_ports sel_10]
set_input_delay 0.239 -clock vclk [get_ports sel_11]
set_input_delay 0.124 -clock vclk [get_ports sel_12]
