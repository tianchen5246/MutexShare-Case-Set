create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.166 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.136 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.119 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.123 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.159 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.13 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.153 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.161 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.152 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.124 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.152 -clock vclk [get_ports sel_4[2]]
