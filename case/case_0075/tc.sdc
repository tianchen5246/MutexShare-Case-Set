set_input_delay 0.109 -clock vclk [get_ports sel_5]
set_input_delay 0.167 -clock vclk [get_ports sel_6]
set_input_delay 0.084 -clock vclk [get_ports sel_7]
set_input_delay 0.25 -clock vclk [get_ports sel_8]
set_input_delay 0.226 -clock vclk [get_ports sel_9]
set_input_delay 0.089 -clock vclk [get_ports sel_10]
set_input_delay 0.15 -clock vclk [get_ports sel_11]
set_input_delay 0.073 -clock vclk [get_ports sel_12]
set_input_delay 0.127 -clock vclk [get_ports sel_13]
set_input_delay 0.228 -clock vclk [get_ports sel_14]
