set_input_delay 0.139 -clock vclk [get_ports sel_8]
set_input_delay 0.087 -clock vclk [get_ports sel_9]
set_input_delay 0.116 -clock vclk [get_ports sel_10]
set_input_delay 0.062 -clock vclk [get_ports sel_11]
