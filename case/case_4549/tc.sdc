create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.232 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.229 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.078 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.133 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.165 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.271 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.122 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.253 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.107 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.097 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.248 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.165 -clock vclk [get_ports sel_8[1]]
