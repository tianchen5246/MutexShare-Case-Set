create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.286 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.244 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.268 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.163 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.13 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.137 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.128 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.205 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.234 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.223 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.161 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.113 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.253 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.223 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.109 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_8[1]]
