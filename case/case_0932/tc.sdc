create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.167 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.216 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.242 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.172 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.154 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.124 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.19 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.103 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.197 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.105 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.092 -clock vclk [get_ports sel_8[1]]
