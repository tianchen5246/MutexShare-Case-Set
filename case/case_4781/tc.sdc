create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.211 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.082 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.301 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.074 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.092 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.078 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.246 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.084 -clock vclk [get_ports sel_3[2]]
