create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.303 -clock vclk [get_ports sel_1]
set_input_delay 0.271 -clock vclk [get_ports sel_2]
set_input_delay 0.338 -clock vclk [get_ports sel_3]
set_input_delay 0.315 -clock vclk [get_ports sel_4]
set_input_delay 0.273 -clock vclk [get_ports sel_5]
set_input_delay 0.345 -clock vclk [get_ports sel_6]
set_input_delay 0.348 -clock vclk [get_ports sel_7]
set_input_delay 0.273 -clock vclk [get_ports sel_8]
set_input_delay 0.262 -clock vclk [get_ports sel_9]
set_input_delay 0.322 -clock vclk [get_ports sel_10]
set_input_delay 0.255 -clock vclk [get_ports sel_11]
set_input_delay 0.327 -clock vclk [get_ports sel_12]
