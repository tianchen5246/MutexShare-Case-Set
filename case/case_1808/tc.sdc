create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.294 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.287 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.275 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.141 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.212 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.258 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.22 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.303 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.291 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.066 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.228 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.294 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.228 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.241 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_5[2]]
