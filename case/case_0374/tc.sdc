create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.263 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.293 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.34 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.274 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.352 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.323 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.247 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.247 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.303 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.213 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.367 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.305 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.267 -clock vclk [get_ports sel_5[2]]
