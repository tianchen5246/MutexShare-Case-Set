create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.143 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.262 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.042 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.256 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.328 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.049 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.342 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.059 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.288 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.126 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.117 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.202 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_5[2]]
