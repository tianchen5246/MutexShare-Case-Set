create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.228 -clock vclk [get_ports sel_1]
set_input_delay 0.177 -clock vclk [get_ports sel_2]
set_input_delay 0.101 -clock vclk [get_ports sel_3]
set_input_delay 0.247 -clock vclk [get_ports sel_4]
set_input_delay 0.266 -clock vclk [get_ports sel_5]
set_input_delay 0.223 -clock vclk [get_ports sel_6]
set_input_delay 0.23 -clock vclk [get_ports sel_7]
set_input_delay 0.167 -clock vclk [get_ports sel_8]
set_input_delay 0.221 -clock vclk [get_ports sel_9]
