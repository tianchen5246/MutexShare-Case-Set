create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.085 -clock vclk [get_ports sel_1]
set_input_delay 0.09 -clock vclk [get_ports sel_2]
set_input_delay 0.087 -clock vclk [get_ports sel_3]
set_input_delay 0.09 -clock vclk [get_ports sel_4]
set_input_delay 0.083 -clock vclk [get_ports sel_5]
set_input_delay 0.058 -clock vclk [get_ports sel_6]
set_input_delay 0.087 -clock vclk [get_ports sel_7]
set_input_delay 0.065 -clock vclk [get_ports sel_8]
set_input_delay 0.09 -clock vclk [get_ports sel_9]
set_input_delay 0.074 -clock vclk [get_ports sel_10]
set_input_delay 0.076 -clock vclk [get_ports sel_11]
set_input_delay 0.08 -clock vclk [get_ports sel_12]
