create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.026 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.034 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.016 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.034 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.073 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.071 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.023 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.021 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.032 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.048 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.056 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.014 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.064 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.058 -clock vclk [get_ports sel_7[1]]
