set_input_delay 0.245 -clock vclk [get_ports sel_6]
set_input_delay 0.286 -clock vclk [get_ports sel_7]
set_input_delay 0.316 -clock vclk [get_ports sel_8]
set_input_delay 0.115 -clock vclk [get_ports sel_9]
set_input_delay 0.052 -clock vclk [get_ports sel_10]
set_input_delay 0.281 -clock vclk [get_ports sel_11]
