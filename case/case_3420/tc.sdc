create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.272 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.057 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.208 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.27 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.284 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.099 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.191 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.262 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.285 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.036 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.327 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.102 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.18 -clock vclk [get_ports sel_5[2]]
