create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.218 -clock vclk [get_ports sel_1]
set_input_delay 0.265 -clock vclk [get_ports sel_2]
set_input_delay 0.265 -clock vclk [get_ports sel_3]
set_input_delay 0.356 -clock vclk [get_ports sel_4]
set_input_delay 0.211 -clock vclk [get_ports sel_5]
set_input_delay 0.302 -clock vclk [get_ports sel_6]
set_input_delay 0.363 -clock vclk [get_ports sel_7]
set_input_delay 0.333 -clock vclk [get_ports sel_8]
set_input_delay 0.234 -clock vclk [get_ports sel_9]
set_input_delay 0.266 -clock vclk [get_ports sel_10]
set_input_delay 0.27 -clock vclk [get_ports sel_11]
