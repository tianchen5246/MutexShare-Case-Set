create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.225 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.166 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.075 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.321 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.22 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.194 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.135 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.28 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.297 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.262 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.273 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.204 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.221 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_6[2]]
