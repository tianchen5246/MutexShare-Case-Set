create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.298 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.136 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_2]
set_input_delay 0.24 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.16 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.139 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.115 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.244 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.192 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.283 -clock vclk [get_ports sel_5[2]]
