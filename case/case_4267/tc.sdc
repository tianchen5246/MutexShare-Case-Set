create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.184 -clock vclk [get_ports sel_1]
set_input_delay 0.197 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.192 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.183 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.193 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.185 -clock vclk [get_ports sel_4]
set_input_delay 0.191 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.186 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.188 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.192 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.191 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.19 -clock vclk [get_ports sel_7]
