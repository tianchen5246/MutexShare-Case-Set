create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.221 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.149 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.107 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.13 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.246 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.229 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.067 -clock vclk [get_ports sel_4[1]]
