create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.3 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.275 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.284 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.281 -clock vclk [get_ports sel_2]
set_input_delay 0.274 -clock vclk [get_ports sel_3]
set_input_delay 0.301 -clock vclk [get_ports sel_4]
set_input_delay 0.271 -clock vclk [get_ports sel_5]
set_input_delay 0.308 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.29 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.284 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.281 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.292 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_7[2]]
set_input_delay 0.293 -clock vclk [get_ports sel_8]
set_input_delay 0.276 -clock vclk [get_ports sel_9]
