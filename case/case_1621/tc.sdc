create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.232 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.161 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.2 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.089 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.078 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.086 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.206 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.234 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.134 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.152 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.107 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.154 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.092 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.118 -clock vclk [get_ports sel_8[1]]
