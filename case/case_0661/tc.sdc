set_input_delay 0.243 -clock vclk [get_ports sel_6]
set_input_delay 0.093 -clock vclk [get_ports sel_7]
set_input_delay 0.153 -clock vclk [get_ports sel_8]
set_input_delay 0.148 -clock vclk [get_ports sel_9]
set_input_delay 0.247 -clock vclk [get_ports sel_10]
set_input_delay 0.131 -clock vclk [get_ports sel_11]
set_input_delay 0.255 -clock vclk [get_ports sel_12]
set_input_delay 0.283 -clock vclk [get_ports sel_13]
