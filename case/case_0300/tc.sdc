create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.208 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.213 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.324 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.253 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.091 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.161 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.234 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.295 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.289 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.204 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.141 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.183 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.147 -clock vclk [get_ports sel_8[1]]
