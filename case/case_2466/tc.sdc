create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.235 -clock vclk [get_ports sel_1]
set_input_delay 0.242 -clock vclk [get_ports sel_2]
set_input_delay 0.243 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.242 -clock vclk [get_ports sel_4]
set_input_delay 0.24 -clock vclk [get_ports sel_5]
set_input_delay 0.232 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.233 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.238 -clock vclk [get_ports sel_6[2]]
