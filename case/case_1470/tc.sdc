create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.03 -clock vclk [get_ports sel_1]
set_input_delay 0.054 -clock vclk [get_ports sel_2]
set_input_delay 0.053 -clock vclk [get_ports sel_3]
set_input_delay 0.053 -clock vclk [get_ports sel_4]
set_input_delay 0.048 -clock vclk [get_ports sel_5]
set_input_delay 0.023 -clock vclk [get_ports sel_6]
set_input_delay 0.043 -clock vclk [get_ports sel_7]
set_input_delay 0.014 -clock vclk [get_ports sel_8]
set_input_delay 0.063 -clock vclk [get_ports sel_9]
set_input_delay 0.05 -clock vclk [get_ports sel_10]
set_input_delay 0.026 -clock vclk [get_ports sel_11]
