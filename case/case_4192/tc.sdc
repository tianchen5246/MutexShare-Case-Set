create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.116 -clock vclk [get_ports sel_1]
set_input_delay 0.184 -clock vclk [get_ports sel_2]
set_input_delay 0.262 -clock vclk [get_ports sel_3]
set_input_delay 0.143 -clock vclk [get_ports sel_4]
set_input_delay 0.255 -clock vclk [get_ports sel_5]
set_input_delay 0.191 -clock vclk [get_ports sel_6]
set_input_delay 0.107 -clock vclk [get_ports sel_7]
set_input_delay 0.197 -clock vclk [get_ports sel_8]
set_input_delay 0.122 -clock vclk [get_ports sel_9]
set_input_delay 0.161 -clock vclk [get_ports sel_10]
set_input_delay 0.258 -clock vclk [get_ports sel_11]
set_input_delay 0.193 -clock vclk [get_ports sel_12]
set_input_delay 0.206 -clock vclk [get_ports sel_13]
