create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.367 -clock vclk [get_ports sel_1]
set_input_delay 0.246 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.321 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.349 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.201 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.315 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.228 -clock vclk [get_ports sel_3[2]]
