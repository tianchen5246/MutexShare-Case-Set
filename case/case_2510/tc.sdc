create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.308 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.333 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.338 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.349 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.325 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.341 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.358 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.36 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.319 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_6[1]]
