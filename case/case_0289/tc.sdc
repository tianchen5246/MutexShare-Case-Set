create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.18 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.205 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.201 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.177 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.165 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.128 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.115 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.116 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.141 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.094 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.127 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.147 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.088 -clock vclk [get_ports sel_7[1]]
