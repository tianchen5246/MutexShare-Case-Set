create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.194 -clock vclk [get_ports sel_1]
set_input_delay 0.17 -clock vclk [get_ports sel_2]
set_input_delay 0.246 -clock vclk [get_ports sel_3]
set_input_delay 0.109 -clock vclk [get_ports sel_4]
set_input_delay 0.249 -clock vclk [get_ports sel_5]
set_input_delay 0.327 -clock vclk [get_ports sel_6]
set_input_delay 0.052 -clock vclk [get_ports sel_7]
set_input_delay 0.275 -clock vclk [get_ports sel_8]
set_input_delay 0.144 -clock vclk [get_ports sel_9]
