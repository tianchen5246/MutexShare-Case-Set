create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.164 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.079 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.067 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.057 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.197 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.124 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.123 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.163 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.07 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.135 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.033 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.161 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.044 -clock vclk [get_ports sel_6[2]]
