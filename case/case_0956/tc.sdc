create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.143 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.098 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.232 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.123 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.175 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.17 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.241 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.18 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.159 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.171 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.21 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.15 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.192 -clock vclk [get_ports sel_7[1]]
