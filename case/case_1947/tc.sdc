create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.095 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.145 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.137 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.104 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.09 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.143 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.069 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.08 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.073 -clock vclk [get_ports sel_4]
