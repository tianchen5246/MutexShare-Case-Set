create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.166 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.14 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.08 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.105 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.197 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.186 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.145 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.067 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.169 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_4[2]]
