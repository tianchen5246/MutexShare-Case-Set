create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.212 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.218 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.222 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.212 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.185 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.202 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.21 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.22 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_4[2]]
