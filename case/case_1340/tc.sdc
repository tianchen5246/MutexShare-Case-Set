create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.091 -clock vclk [get_ports sel_1]
set_input_delay 0.071 -clock vclk [get_ports sel_2]
set_input_delay 0.079 -clock vclk [get_ports sel_3]
set_input_delay 0.146 -clock vclk [get_ports sel_4]
set_input_delay 0.137 -clock vclk [get_ports sel_5]
set_input_delay 0.119 -clock vclk [get_ports sel_6]
set_input_delay 0.035 -clock vclk [get_ports sel_7]
set_input_delay 0.063 -clock vclk [get_ports sel_8]
set_input_delay 0.15 -clock vclk [get_ports sel_9]
set_input_delay 0.071 -clock vclk [get_ports sel_10]
set_input_delay 0.1 -clock vclk [get_ports sel_11]
set_input_delay 0.177 -clock vclk [get_ports sel_12]
set_input_delay 0.114 -clock vclk [get_ports sel_13]
set_input_delay 0.166 -clock vclk [get_ports sel_14]
