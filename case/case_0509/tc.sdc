create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.27 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.325 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.152 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.328 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.157 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.341 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.16 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.147 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.136 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.336 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.197 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.286 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.31 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.326 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.317 -clock vclk [get_ports sel_8[0]]
