set_input_delay 0.02 -clock vclk [get_ports sel_6]
set_input_delay 0.099 -clock vclk [get_ports sel_7]
set_input_delay 0.265 -clock vclk [get_ports sel_8]
set_input_delay 0.233 -clock vclk [get_ports sel_9]
set_input_delay 0.079 -clock vclk [get_ports sel_10]
set_input_delay 0.204 -clock vclk [get_ports sel_11]
set_input_delay 0.173 -clock vclk [get_ports sel_12]
