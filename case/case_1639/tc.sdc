create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.232 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.326 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.321 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.321 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.161 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.33 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.251 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.175 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.221 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.329 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.331 -clock vclk [get_ports sel_5[2]]
