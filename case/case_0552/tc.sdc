create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.371 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.302 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.336 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.327 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.309 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.362 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.294 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.317 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.331 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.369 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.346 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.361 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.331 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.292 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.371 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.319 -clock vclk [get_ports sel_8[1]]
