create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.379 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.377 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.375 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.391 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.374 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.382 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.393 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.394 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.387 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.375 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.389 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.376 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.377 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.38 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.376 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.387 -clock vclk [get_ports sel_8[1]]
