create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.042 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.097 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.095 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.146 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.143 -clock vclk [get_ports sel_3]
set_input_delay 0.064 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.098 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.152 -clock vclk [get_ports sel_5]
set_input_delay 0.112 -clock vclk [get_ports sel_6]
set_input_delay 0.036 -clock vclk [get_ports sel_7]
set_input_delay 0.042 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.052 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.13 -clock vclk [get_ports sel_8[2]]
set_input_delay 0.155 -clock vclk [get_ports sel_9]
set_input_delay 0.057 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.111 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_10[2]]
