create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.226 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.291 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.225 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.193 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.286 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.16 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.293 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.253 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.304 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.255 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.149 -clock vclk [get_ports sel_5[1]]
