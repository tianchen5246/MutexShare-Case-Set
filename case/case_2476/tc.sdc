create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.042 -clock vclk [get_ports sel_1]
set_input_delay 0.054 -clock vclk [get_ports sel_2]
set_input_delay 0.039 -clock vclk [get_ports sel_3]
set_input_delay 0.035 -clock vclk [get_ports sel_4]
set_input_delay 0.031 -clock vclk [get_ports sel_5]
set_input_delay 0.038 -clock vclk [get_ports sel_6]
set_input_delay 0.07 -clock vclk [get_ports sel_7]
set_input_delay 0.075 -clock vclk [get_ports sel_8]
