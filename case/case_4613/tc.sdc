create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.33 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.223 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.148 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.197 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.105 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.325 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.329 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.195 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.155 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.288 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.146 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.095 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.324 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.29 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.279 -clock vclk [get_ports sel_8[1]]
