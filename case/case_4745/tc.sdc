create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.089 -clock vclk [get_ports sel_1]
set_input_delay 0.09 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.18 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.142 -clock vclk [get_ports sel_3]
set_input_delay 0.171 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.112 -clock vclk [get_ports sel_5]
set_input_delay 0.114 -clock vclk [get_ports sel_6]
set_input_delay 0.168 -clock vclk [get_ports sel_7]
set_input_delay 0.082 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.152 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.087 -clock vclk [get_ports sel_9]
set_input_delay 0.196 -clock vclk [get_ports sel_10]
set_input_delay 0.135 -clock vclk [get_ports sel_11]
set_input_delay 0.079 -clock vclk [get_ports sel_12[0]]
set_input_delay 0.134 -clock vclk [get_ports sel_12[1]]
set_input_delay 0.137 -clock vclk [get_ports sel_13[0]]
set_input_delay 0.099 -clock vclk [get_ports sel_13[1]]
