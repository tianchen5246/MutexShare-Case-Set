create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.303 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.203 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.342 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.27 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.163 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.387 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.197 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.383 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.209 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.193 -clock vclk [get_ports sel_5[1]]
