create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.148 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.153 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.229 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.025 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.189 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.055 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.132 -clock vclk [get_ports sel_3[2]]
