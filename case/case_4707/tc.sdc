create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.108 -clock vclk [get_ports sel_1]
set_input_delay 0.232 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.065 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.232 -clock vclk [get_ports sel_3]
set_input_delay 0.219 -clock vclk [get_ports sel_4]
set_input_delay 0.274 -clock vclk [get_ports sel_5]
set_input_delay 0.226 -clock vclk [get_ports sel_6]
set_input_delay 0.259 -clock vclk [get_ports sel_7]
set_input_delay 0.071 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.196 -clock vclk [get_ports sel_9]
set_input_delay 0.182 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.164 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.244 -clock vclk [get_ports sel_11[0]]
set_input_delay 0.254 -clock vclk [get_ports sel_11[1]]
