create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.389 -clock vclk [get_ports sel_1]
set_input_delay 0.391 -clock vclk [get_ports sel_2]
set_input_delay 0.39 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.392 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.39 -clock vclk [get_ports sel_4]
set_input_delay 0.393 -clock vclk [get_ports sel_5]
set_input_delay 0.392 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.387 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.391 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.392 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.389 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.392 -clock vclk [get_ports sel_8]
