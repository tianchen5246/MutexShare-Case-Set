create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.131 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.046 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.134 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.011 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.021 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.062 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.079 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.086 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.055 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.057 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.046 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.053 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.023 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.111 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.103 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.093 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.098 -clock vclk [get_ports sel_8[1]]
