set_input_delay 0.262 -clock vclk [get_ports sel_6]
set_input_delay 0.278 -clock vclk [get_ports sel_7]
set_input_delay 0.289 -clock vclk [get_ports sel_8]
set_input_delay 0.264 -clock vclk [get_ports sel_9]
set_input_delay 0.261 -clock vclk [get_ports sel_10]
set_input_delay 0.288 -clock vclk [get_ports sel_11]
