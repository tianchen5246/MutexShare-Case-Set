create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.245 -clock vclk [get_ports sel_1]
set_input_delay 0.071 -clock vclk [get_ports sel_2]
set_input_delay 0.157 -clock vclk [get_ports sel_3]
set_input_delay 0.121 -clock vclk [get_ports sel_4]
set_input_delay 0.222 -clock vclk [get_ports sel_5]
set_input_delay 0.209 -clock vclk [get_ports sel_6]
set_input_delay 0.067 -clock vclk [get_ports sel_7]
set_input_delay 0.235 -clock vclk [get_ports sel_8]
set_input_delay 0.197 -clock vclk [get_ports sel_9]
set_input_delay 0.15 -clock vclk [get_ports sel_10]
