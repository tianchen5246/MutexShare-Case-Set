create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.018 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.042 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.017 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.076 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.07 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.046 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.04 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.026 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.07 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.038 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.068 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.041 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.073 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.051 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.021 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.028 -clock vclk [get_ports sel_8[1]]
