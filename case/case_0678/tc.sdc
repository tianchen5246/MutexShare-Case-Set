create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.308 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.301 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.316 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.315 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.306 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.308 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.282 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.312 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.297 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.279 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.284 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.312 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.315 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.308 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.29 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.276 -clock vclk [get_ports sel_7[1]]
