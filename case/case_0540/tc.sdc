create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.09 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.09 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.173 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.305 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.132 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.033 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.297 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.122 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.264 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.295 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.103 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.072 -clock vclk [get_ports sel_5[2]]
