set_input_delay 0.172 -clock vclk [get_ports sel_6]
set_input_delay 0.171 -clock vclk [get_ports sel_7]
set_input_delay 0.113 -clock vclk [get_ports sel_8]
set_input_delay 0.105 -clock vclk [get_ports sel_9]
set_input_delay 0.223 -clock vclk [get_ports sel_10]
set_input_delay 0.17 -clock vclk [get_ports sel_11]
set_input_delay 0.198 -clock vclk [get_ports sel_12]
set_input_delay 0.138 -clock vclk [get_ports sel_13]
set_input_delay 0.097 -clock vclk [get_ports sel_14]
