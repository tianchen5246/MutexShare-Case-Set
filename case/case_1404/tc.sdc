set_input_delay 0.04 -clock vclk [get_ports sel_5]
set_input_delay 0.02 -clock vclk [get_ports sel_6]
set_input_delay 0.089 -clock vclk [get_ports sel_7]
set_input_delay 0.09 -clock vclk [get_ports sel_8]
set_input_delay 0.083 -clock vclk [get_ports sel_9]
set_input_delay 0.092 -clock vclk [get_ports sel_10]
set_input_delay 0.042 -clock vclk [get_ports sel_11]
set_input_delay 0.084 -clock vclk [get_ports sel_12]
set_input_delay 0.098 -clock vclk [get_ports sel_13]
set_input_delay 0.102 -clock vclk [get_ports sel_14]
