create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.227 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.229 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.195 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.299 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.104 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.119 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.065 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.263 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.191 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.066 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.26 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.155 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.223 -clock vclk [get_ports sel_7[1]]
