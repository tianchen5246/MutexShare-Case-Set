create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.15 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.08 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.11 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.149 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.091 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.085 -clock vclk [get_ports sel_3]
set_input_delay 0.211 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.111 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.201 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.222 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.211 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.174 -clock vclk [get_ports sel_6]
set_input_delay 0.189 -clock vclk [get_ports sel_7]
