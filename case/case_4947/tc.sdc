create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.266 -clock vclk [get_ports sel_1]
set_input_delay 0.103 -clock vclk [get_ports sel_2]
set_input_delay 0.209 -clock vclk [get_ports sel_3]
set_input_delay 0.117 -clock vclk [get_ports sel_4]
set_input_delay 0.041 -clock vclk [get_ports sel_5]
set_input_delay 0.184 -clock vclk [get_ports sel_6]
set_input_delay 0.248 -clock vclk [get_ports sel_7]
set_input_delay 0.037 -clock vclk [get_ports sel_8]
set_input_delay 0.101 -clock vclk [get_ports sel_9]
set_input_delay 0.148 -clock vclk [get_ports sel_10]
set_input_delay 0.231 -clock vclk [get_ports sel_11]
