create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.18 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.19 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.224 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.246 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.247 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.172 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.191 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.251 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.171 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.156 -clock vclk [get_ports sel_5[2]]
