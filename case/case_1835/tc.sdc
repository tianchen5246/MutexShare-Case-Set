create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.298 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.197 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.268 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.197 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.293 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.107 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.144 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.178 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.157 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.28 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.16 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.219 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.12 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.346 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.232 -clock vclk [get_ports sel_8[0]]
