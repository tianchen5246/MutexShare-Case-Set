create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.32 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.319 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.295 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.292 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.315 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.21 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.307 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.191 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.195 -clock vclk [get_ports sel_3[2]]
