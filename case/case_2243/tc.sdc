create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.011 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.011 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.008 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.009 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.024 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.018 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.016 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.013 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.026 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.017 -clock vclk [get_ports sel_5[1]]
