create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.316 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.31 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.294 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.27 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.333 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.291 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.335 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.323 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.254 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.311 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.26 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.265 -clock vclk [get_ports sel_5[1]]
