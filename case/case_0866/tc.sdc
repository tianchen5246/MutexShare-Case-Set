create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.224 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.255 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.229 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.255 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.199 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.236 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.264 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.205 -clock vclk [get_ports sel_4[1]]
