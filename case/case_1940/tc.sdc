create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.104 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.201 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.137 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.287 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.114 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.278 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.253 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.243 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.121 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.162 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_6[2]]
