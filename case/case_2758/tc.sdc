create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.311 -clock vclk [get_ports sel_1]
set_input_delay 0.187 -clock vclk [get_ports sel_2]
set_input_delay 0.272 -clock vclk [get_ports sel_3]
set_input_delay 0.29 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.137 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.234 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.321 -clock vclk [get_ports sel_5[1]]
