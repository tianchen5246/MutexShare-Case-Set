create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.323 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.077 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.229 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.323 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.337 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.047 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.099 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.297 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.143 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.087 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.028 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.119 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_6[1]]
