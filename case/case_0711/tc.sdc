create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.136 -clock vclk [get_ports sel_1]
set_input_delay 0.183 -clock vclk [get_ports sel_2]
set_input_delay 0.128 -clock vclk [get_ports sel_3]
set_input_delay 0.103 -clock vclk [get_ports sel_4]
set_input_delay 0.114 -clock vclk [get_ports sel_5]
set_input_delay 0.131 -clock vclk [get_ports sel_6]
set_input_delay 0.137 -clock vclk [get_ports sel_7]
set_input_delay 0.146 -clock vclk [get_ports sel_8]
set_input_delay 0.115 -clock vclk [get_ports sel_9]
set_input_delay 0.164 -clock vclk [get_ports sel_10]
set_input_delay 0.103 -clock vclk [get_ports sel_11]
set_input_delay 0.118 -clock vclk [get_ports sel_12]
