create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.068 -clock vclk [get_ports sel_1]
set_input_delay 0.061 -clock vclk [get_ports sel_2]
set_input_delay 0.066 -clock vclk [get_ports sel_3]
set_input_delay 0.081 -clock vclk [get_ports sel_4]
set_input_delay 0.08 -clock vclk [get_ports sel_5]
set_input_delay 0.058 -clock vclk [get_ports sel_6]
set_input_delay 0.069 -clock vclk [get_ports sel_7]
set_input_delay 0.062 -clock vclk [get_ports sel_8]
set_input_delay 0.056 -clock vclk [get_ports sel_9]
set_input_delay 0.086 -clock vclk [get_ports sel_10]
set_input_delay 0.084 -clock vclk [get_ports sel_11]
set_input_delay 0.076 -clock vclk [get_ports sel_12]
