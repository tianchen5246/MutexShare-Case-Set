create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.144 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.121 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.167 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.13 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.161 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.111 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.188 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.191 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.172 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.172 -clock vclk [get_ports sel_5[1]]
