set_input_delay 0.169 -clock vclk [get_ports sel_5]
set_input_delay 0.279 -clock vclk [get_ports sel_6]
set_input_delay 0.142 -clock vclk [get_ports sel_7]
set_input_delay 0.222 -clock vclk [get_ports sel_8]
set_input_delay 0.23 -clock vclk [get_ports sel_9]
set_input_delay 0.314 -clock vclk [get_ports sel_10]
set_input_delay 0.211 -clock vclk [get_ports sel_11]
set_input_delay 0.128 -clock vclk [get_ports sel_12]
set_input_delay 0.139 -clock vclk [get_ports sel_13]
