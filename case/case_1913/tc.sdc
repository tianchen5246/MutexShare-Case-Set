create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.273 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.322 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_2]
set_input_delay 0.266 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.21 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.32 -clock vclk [get_ports sel_4]
set_input_delay 0.291 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_5[1]]
