create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.128 -clock vclk [get_ports sel_1]
set_input_delay 0.147 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.14 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.146 -clock vclk [get_ports sel_3]
set_input_delay 0.16 -clock vclk [get_ports sel_4]
set_input_delay 0.134 -clock vclk [get_ports sel_5]
set_input_delay 0.139 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.156 -clock vclk [get_ports sel_6[1]]
