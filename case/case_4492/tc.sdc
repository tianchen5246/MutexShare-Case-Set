create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.133 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.146 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.231 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.137 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.14 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.139 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.139 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.133 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.196 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.145 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_8[1]]
