create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.224 -clock vclk [get_ports sel_1]
set_input_delay 0.151 -clock vclk [get_ports sel_2]
set_input_delay 0.082 -clock vclk [get_ports sel_3]
set_input_delay 0.244 -clock vclk [get_ports sel_4]
set_input_delay 0.176 -clock vclk [get_ports sel_5]
set_input_delay 0.068 -clock vclk [get_ports sel_6]
set_input_delay 0.229 -clock vclk [get_ports sel_7]
set_input_delay 0.1 -clock vclk [get_ports sel_8]
set_input_delay 0.068 -clock vclk [get_ports sel_9]
