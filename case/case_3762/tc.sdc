create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.021 -clock vclk [get_ports sel_1]
set_input_delay 0.057 -clock vclk [get_ports sel_2]
set_input_delay 0.03 -clock vclk [get_ports sel_3]
set_input_delay 0.038 -clock vclk [get_ports sel_4]
set_input_delay 0.024 -clock vclk [get_ports sel_5]
set_input_delay 0.042 -clock vclk [get_ports sel_6]
set_input_delay 0.076 -clock vclk [get_ports sel_7]
set_input_delay 0.03 -clock vclk [get_ports sel_8]
set_input_delay 0.026 -clock vclk [get_ports sel_9]
set_input_delay 0.061 -clock vclk [get_ports sel_10]
set_input_delay 0.062 -clock vclk [get_ports sel_11]
set_input_delay 0.077 -clock vclk [get_ports sel_12]
set_input_delay 0.028 -clock vclk [get_ports sel_13]
