create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.098 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.124 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.139 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.154 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.149 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.116 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.114 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.145 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.138 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_4[2]]
