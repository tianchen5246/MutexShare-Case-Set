create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.197 -clock vclk [get_ports sel_1]
set_input_delay 0.239 -clock vclk [get_ports sel_2]
set_input_delay 0.175 -clock vclk [get_ports sel_3]
set_input_delay 0.24 -clock vclk [get_ports sel_4]
set_input_delay 0.246 -clock vclk [get_ports sel_5]
set_input_delay 0.2 -clock vclk [get_ports sel_6]
set_input_delay 0.23 -clock vclk [get_ports sel_7]
set_input_delay 0.254 -clock vclk [get_ports sel_8]
set_input_delay 0.225 -clock vclk [get_ports sel_9]
set_input_delay 0.262 -clock vclk [get_ports sel_10]
set_input_delay 0.209 -clock vclk [get_ports sel_11]
set_input_delay 0.259 -clock vclk [get_ports sel_12]
set_input_delay 0.252 -clock vclk [get_ports sel_13]
