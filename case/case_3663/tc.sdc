create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.015 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.014 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.009 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.009 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.012 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.014 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.014 -clock vclk [get_ports sel_4]
set_input_delay 0.011 -clock vclk [get_ports sel_5]
set_input_delay 0.006 -clock vclk [get_ports sel_6]
set_input_delay 0.004 -clock vclk [get_ports sel_7]
set_input_delay 0.012 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.012 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.007 -clock vclk [get_ports sel_9]
set_input_delay 0.009 -clock vclk [get_ports sel_10]
set_input_delay 0.012 -clock vclk [get_ports sel_11[0]]
set_input_delay 0.015 -clock vclk [get_ports sel_11[1]]
set_input_delay 0.008 -clock vclk [get_ports sel_12]
