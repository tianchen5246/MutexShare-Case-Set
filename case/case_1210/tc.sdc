create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.233 -clock vclk [get_ports sel_1]
set_input_delay 0.214 -clock vclk [get_ports sel_2]
set_input_delay 0.196 -clock vclk [get_ports sel_3]
set_input_delay 0.221 -clock vclk [get_ports sel_4]
set_input_delay 0.177 -clock vclk [get_ports sel_5]
set_input_delay 0.169 -clock vclk [get_ports sel_6]
set_input_delay 0.201 -clock vclk [get_ports sel_7]
set_input_delay 0.202 -clock vclk [get_ports sel_8]
set_input_delay 0.221 -clock vclk [get_ports sel_9]
set_input_delay 0.173 -clock vclk [get_ports sel_10]
set_input_delay 0.183 -clock vclk [get_ports sel_11]
