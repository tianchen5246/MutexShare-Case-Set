create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.08 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.21 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.305 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.218 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.141 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.066 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.177 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.158 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.198 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.238 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.086 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.201 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.112 -clock vclk [get_ports sel_8[1]]
