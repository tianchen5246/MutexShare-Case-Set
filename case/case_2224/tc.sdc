create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.039 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.139 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.112 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.107 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.077 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.082 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.088 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.097 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.128 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.049 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.105 -clock vclk [get_ports sel_5[2]]
