create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.263 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.228 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.354 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.215 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.286 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.296 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.329 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.317 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.338 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.27 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.258 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.243 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.322 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.27 -clock vclk [get_ports sel_5[2]]
