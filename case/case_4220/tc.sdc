set_input_delay 0.261 -clock vclk [get_ports sel_5]
set_input_delay 0.265 -clock vclk [get_ports sel_6]
set_input_delay 0.329 -clock vclk [get_ports sel_7]
set_input_delay 0.31 -clock vclk [get_ports sel_8]
set_input_delay 0.326 -clock vclk [get_ports sel_9]
set_input_delay 0.273 -clock vclk [get_ports sel_10]
set_input_delay 0.277 -clock vclk [get_ports sel_11]
set_input_delay 0.282 -clock vclk [get_ports sel_12]
set_input_delay 0.259 -clock vclk [get_ports sel_13]
