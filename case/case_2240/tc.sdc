create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.098 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.184 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.102 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.131 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.095 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.111 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.152 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.184 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.115 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.21 -clock vclk [get_ports sel_5[2]]
