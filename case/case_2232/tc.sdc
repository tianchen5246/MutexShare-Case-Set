create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.209 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.178 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.213 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.231 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.262 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.258 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.172 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.165 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.224 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.191 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.125 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.154 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.198 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.148 -clock vclk [get_ports sel_5[2]]
