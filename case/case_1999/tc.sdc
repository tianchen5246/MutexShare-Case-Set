create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.359 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.369 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.358 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.362 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.357 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.359 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.365 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.366 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.364 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.365 -clock vclk [get_ports sel_4[1]]
