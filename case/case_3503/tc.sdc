create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.192 -clock vclk [get_ports sel_1]
set_input_delay 0.203 -clock vclk [get_ports sel_2]
set_input_delay 0.215 -clock vclk [get_ports sel_3]
set_input_delay 0.201 -clock vclk [get_ports sel_4]
set_input_delay 0.241 -clock vclk [get_ports sel_5]
set_input_delay 0.202 -clock vclk [get_ports sel_6]
set_input_delay 0.195 -clock vclk [get_ports sel_7]
set_input_delay 0.19 -clock vclk [get_ports sel_8]
set_input_delay 0.188 -clock vclk [get_ports sel_9]
set_input_delay 0.205 -clock vclk [get_ports sel_10]
set_input_delay 0.216 -clock vclk [get_ports sel_11]
set_input_delay 0.221 -clock vclk [get_ports sel_12]
