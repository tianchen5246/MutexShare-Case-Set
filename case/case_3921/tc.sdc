create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.195 -clock vclk [get_ports sel_1]
set_input_delay 0.207 -clock vclk [get_ports sel_2]
set_input_delay 0.17 -clock vclk [get_ports sel_3]
set_input_delay 0.2 -clock vclk [get_ports sel_4]
set_input_delay 0.129 -clock vclk [get_ports sel_5]
set_input_delay 0.16 -clock vclk [get_ports sel_6]
set_input_delay 0.2 -clock vclk [get_ports sel_7]
set_input_delay 0.204 -clock vclk [get_ports sel_8]
set_input_delay 0.148 -clock vclk [get_ports sel_9]
set_input_delay 0.208 -clock vclk [get_ports sel_10]
set_input_delay 0.114 -clock vclk [get_ports sel_11]
set_input_delay 0.138 -clock vclk [get_ports sel_12]
set_input_delay 0.141 -clock vclk [get_ports sel_13]
