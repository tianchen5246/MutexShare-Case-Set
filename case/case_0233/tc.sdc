create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.259 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.256 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.258 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.258 -clock vclk [get_ports sel_3]
set_input_delay 0.258 -clock vclk [get_ports sel_4]
set_input_delay 0.252 -clock vclk [get_ports sel_5]
set_input_delay 0.255 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.251 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.252 -clock vclk [get_ports sel_7]
set_input_delay 0.254 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.252 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.255 -clock vclk [get_ports sel_9]
set_input_delay 0.259 -clock vclk [get_ports sel_10]
set_input_delay 0.255 -clock vclk [get_ports sel_11]
