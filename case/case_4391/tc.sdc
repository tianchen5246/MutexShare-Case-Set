create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.245 -clock vclk [get_ports sel_1]
set_input_delay 0.305 -clock vclk [get_ports sel_2]
set_input_delay 0.298 -clock vclk [get_ports sel_3]
set_input_delay 0.259 -clock vclk [get_ports sel_4]
set_input_delay 0.306 -clock vclk [get_ports sel_5]
set_input_delay 0.285 -clock vclk [get_ports sel_6]
set_input_delay 0.273 -clock vclk [get_ports sel_7]
set_input_delay 0.341 -clock vclk [get_ports sel_8]
set_input_delay 0.295 -clock vclk [get_ports sel_9]
set_input_delay 0.286 -clock vclk [get_ports sel_10]
set_input_delay 0.303 -clock vclk [get_ports sel_11]
set_input_delay 0.355 -clock vclk [get_ports sel_12]
set_input_delay 0.254 -clock vclk [get_ports sel_13]
