create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.227 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.245 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.134 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.152 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.104 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.031 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.162 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.078 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.046 -clock vclk [get_ports sel_5[1]]
