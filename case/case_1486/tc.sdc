create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.325 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.284 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.333 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.339 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.233 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.304 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.313 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.28 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.215 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.298 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.244 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.271 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.32 -clock vclk [get_ports sel_7[1]]
