create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.172 -clock vclk [get_ports sel_1]
set_input_delay 0.193 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.174 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.198 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.207 -clock vclk [get_ports sel_5]
set_input_delay 0.191 -clock vclk [get_ports sel_6]
set_input_delay 0.174 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.178 -clock vclk [get_ports sel_8]
set_input_delay 0.192 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.201 -clock vclk [get_ports sel_9[1]]
