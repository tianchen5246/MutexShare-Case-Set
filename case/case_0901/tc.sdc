create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.235 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.241 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.2 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.217 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.22 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.274 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.196 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.224 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.242 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.277 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.212 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.197 -clock vclk [get_ports sel_8[1]]
