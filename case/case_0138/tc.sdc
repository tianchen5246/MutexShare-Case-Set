create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.189 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.186 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.156 -clock vclk [get_ports sel_2]
set_input_delay 0.143 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.168 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.132 -clock vclk [get_ports sel_4]
set_input_delay 0.19 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.151 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.162 -clock vclk [get_ports sel_6]
set_input_delay 0.151 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_8]
set_input_delay 0.165 -clock vclk [get_ports sel_9]
set_input_delay 0.149 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.177 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.113 -clock vclk [get_ports sel_11]
