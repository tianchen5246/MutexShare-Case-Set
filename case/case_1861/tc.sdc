create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.137 -clock vclk [get_ports sel_1]
set_input_delay 0.169 -clock vclk [get_ports sel_2]
set_input_delay 0.148 -clock vclk [get_ports sel_3]
set_input_delay 0.202 -clock vclk [get_ports sel_4]
set_input_delay 0.241 -clock vclk [get_ports sel_5]
set_input_delay 0.239 -clock vclk [get_ports sel_6]
set_input_delay 0.158 -clock vclk [get_ports sel_7]
set_input_delay 0.234 -clock vclk [get_ports sel_8]
set_input_delay 0.23 -clock vclk [get_ports sel_9]
set_input_delay 0.167 -clock vclk [get_ports sel_10]
set_input_delay 0.175 -clock vclk [get_ports sel_11]
set_input_delay 0.137 -clock vclk [get_ports sel_12]
set_input_delay 0.128 -clock vclk [get_ports sel_13]
