create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.347 -clock vclk [get_ports sel_1]
set_input_delay 0.139 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.282 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.109 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.066 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.277 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.158 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.062 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.097 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.203 -clock vclk [get_ports sel_6]
set_input_delay 0.229 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.115 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.07 -clock vclk [get_ports sel_8]
