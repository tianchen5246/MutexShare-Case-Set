create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.166 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.334 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.318 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.182 -clock vclk [get_ports sel_2]
set_input_delay 0.311 -clock vclk [get_ports sel_3]
set_input_delay 0.171 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.099 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.069 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.311 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.21 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.169 -clock vclk [get_ports sel_6]
