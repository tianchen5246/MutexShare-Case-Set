create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.151 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.19 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.164 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.181 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.229 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.186 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.215 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.223 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.151 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_7[1]]
