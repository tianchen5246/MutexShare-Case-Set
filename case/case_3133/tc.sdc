set_input_delay 0.049 -clock vclk [get_ports sel_5]
set_input_delay 0.035 -clock vclk [get_ports sel_6]
set_input_delay 0.029 -clock vclk [get_ports sel_7]
set_input_delay 0.034 -clock vclk [get_ports sel_8]
set_input_delay 0.033 -clock vclk [get_ports sel_9]
set_input_delay 0.027 -clock vclk [get_ports sel_10]
set_input_delay 0.042 -clock vclk [get_ports sel_11]
set_input_delay 0.049 -clock vclk [get_ports sel_12]
set_input_delay 0.033 -clock vclk [get_ports sel_13]
set_input_delay 0.048 -clock vclk [get_ports sel_14]
