create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.211 -clock vclk [get_ports sel_1]
set_input_delay 0.121 -clock vclk [get_ports sel_2]
set_input_delay 0.202 -clock vclk [get_ports sel_3]
set_input_delay 0.165 -clock vclk [get_ports sel_4]
set_input_delay 0.151 -clock vclk [get_ports sel_5]
set_input_delay 0.183 -clock vclk [get_ports sel_6]
set_input_delay 0.166 -clock vclk [get_ports sel_7]
set_input_delay 0.137 -clock vclk [get_ports sel_8]
set_input_delay 0.21 -clock vclk [get_ports sel_9]
set_input_delay 0.054 -clock vclk [get_ports sel_10]
set_input_delay 0.131 -clock vclk [get_ports sel_11]
set_input_delay 0.196 -clock vclk [get_ports sel_12]
set_input_delay 0.052 -clock vclk [get_ports sel_13]
set_input_delay 0.157 -clock vclk [get_ports sel_14]
