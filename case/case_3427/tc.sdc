create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.218 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.239 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.054 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.091 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.068 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.103 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.065 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.079 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.115 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.211 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.218 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.102 -clock vclk [get_ports sel_8[1]]
