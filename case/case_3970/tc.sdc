create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.291 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.328 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.344 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.301 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.291 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.327 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.306 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.288 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.3 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.287 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.31 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.301 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.307 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.32 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.307 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.312 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.319 -clock vclk [get_ports sel_8[1]]
