create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.179 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.197 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.183 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.21 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.156 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.195 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.193 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.148 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.143 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.168 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.217 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.166 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.192 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.152 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.151 -clock vclk [get_ports sel_5[2]]
