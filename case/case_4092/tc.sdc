create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.131 -clock vclk [get_ports sel_1]
set_input_delay 0.194 -clock vclk [get_ports sel_2]
set_input_delay 0.161 -clock vclk [get_ports sel_3]
set_input_delay 0.294 -clock vclk [get_ports sel_4]
set_input_delay 0.125 -clock vclk [get_ports sel_5]
set_input_delay 0.31 -clock vclk [get_ports sel_6]
set_input_delay 0.175 -clock vclk [get_ports sel_7]
set_input_delay 0.222 -clock vclk [get_ports sel_8]
set_input_delay 0.17 -clock vclk [get_ports sel_9]
set_input_delay 0.144 -clock vclk [get_ports sel_10]
set_input_delay 0.216 -clock vclk [get_ports sel_11]
set_input_delay 0.263 -clock vclk [get_ports sel_12]
