set_input_delay 0.066 -clock vclk [get_ports sel_6]
set_input_delay 0.058 -clock vclk [get_ports sel_7]
set_input_delay 0.17 -clock vclk [get_ports sel_8]
set_input_delay 0.137 -clock vclk [get_ports sel_9]
set_input_delay 0.073 -clock vclk [get_ports sel_10]
set_input_delay 0.187 -clock vclk [get_ports sel_11]
