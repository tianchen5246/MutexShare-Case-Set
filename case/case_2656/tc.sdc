create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.163 -clock vclk [get_ports sel_1]
set_input_delay 0.168 -clock vclk [get_ports sel_2]
set_input_delay 0.165 -clock vclk [get_ports sel_3]
set_input_delay 0.169 -clock vclk [get_ports sel_4]
set_input_delay 0.167 -clock vclk [get_ports sel_5]
set_input_delay 0.164 -clock vclk [get_ports sel_6]
set_input_delay 0.165 -clock vclk [get_ports sel_7]
set_input_delay 0.164 -clock vclk [get_ports sel_8]
set_input_delay 0.165 -clock vclk [get_ports sel_9]
set_input_delay 0.165 -clock vclk [get_ports sel_10]
set_input_delay 0.164 -clock vclk [get_ports sel_11]
