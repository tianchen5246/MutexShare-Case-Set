create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.184 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.164 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.104 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.116 -clock vclk [get_ports sel_2]
set_input_delay 0.106 -clock vclk [get_ports sel_3]
set_input_delay 0.246 -clock vclk [get_ports sel_4]
set_input_delay 0.134 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.161 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.212 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.187 -clock vclk [get_ports sel_6]
set_input_delay 0.17 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.064 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.049 -clock vclk [get_ports sel_7[2]]
