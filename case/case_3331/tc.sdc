create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.203 -clock vclk [get_ports sel_1]
set_input_delay 0.245 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.245 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_4]
set_input_delay 0.193 -clock vclk [get_ports sel_5]
set_input_delay 0.255 -clock vclk [get_ports sel_6]
set_input_delay 0.224 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.217 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.238 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.207 -clock vclk [get_ports sel_9]
set_input_delay 0.209 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.232 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_11]
