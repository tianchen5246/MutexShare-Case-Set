create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.172 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.211 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.203 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.209 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.21 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.222 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.174 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.209 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.223 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.197 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.212 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.208 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.215 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_7[1]]
