create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.178 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.201 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.223 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.208 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.19 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.184 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.217 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.22 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.196 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.209 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.205 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_7[1]]
