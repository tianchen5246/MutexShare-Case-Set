create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.287 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.279 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.185 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.244 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.356 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.241 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.274 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.296 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.128 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.309 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_6[1]]
