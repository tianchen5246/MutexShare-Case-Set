create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.235 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.109 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.142 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.2 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.258 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.258 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.117 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.245 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.15 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.199 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.096 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.117 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.067 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.076 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.023 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.22 -clock vclk [get_ports sel_8[1]]
