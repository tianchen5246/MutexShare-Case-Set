create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.143 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.242 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.195 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.132 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.24 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.323 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.19 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.232 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.172 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.274 -clock vclk [get_ports sel_6]
set_input_delay 0.104 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.137 -clock vclk [get_ports sel_7[1]]
