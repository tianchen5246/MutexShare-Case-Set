create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.155 -clock vclk [get_ports sel_1]
set_input_delay 0.197 -clock vclk [get_ports sel_2]
set_input_delay 0.154 -clock vclk [get_ports sel_3]
set_input_delay 0.163 -clock vclk [get_ports sel_4]
set_input_delay 0.186 -clock vclk [get_ports sel_5]
set_input_delay 0.135 -clock vclk [get_ports sel_6]
set_input_delay 0.196 -clock vclk [get_ports sel_7]
set_input_delay 0.195 -clock vclk [get_ports sel_8]
set_input_delay 0.151 -clock vclk [get_ports sel_9]
set_input_delay 0.134 -clock vclk [get_ports sel_10]
set_input_delay 0.167 -clock vclk [get_ports sel_11]
set_input_delay 0.134 -clock vclk [get_ports sel_12]
