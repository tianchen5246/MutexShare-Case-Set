create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.039 -clock vclk [get_ports sel_1]
set_input_delay 0.068 -clock vclk [get_ports sel_2]
set_input_delay 0.156 -clock vclk [get_ports sel_3]
set_input_delay 0.168 -clock vclk [get_ports sel_4]
set_input_delay 0.225 -clock vclk [get_ports sel_5]
set_input_delay 0.149 -clock vclk [get_ports sel_6]
set_input_delay 0.239 -clock vclk [get_ports sel_7]
set_input_delay 0.041 -clock vclk [get_ports sel_8]
set_input_delay 0.086 -clock vclk [get_ports sel_9]
set_input_delay 0.097 -clock vclk [get_ports sel_10]
set_input_delay 0.207 -clock vclk [get_ports sel_11]
