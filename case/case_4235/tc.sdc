create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.326 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.228 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.282 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.289 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.16 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.28 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.305 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.314 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.158 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.316 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.191 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.298 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.322 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.189 -clock vclk [get_ports sel_5[2]]
