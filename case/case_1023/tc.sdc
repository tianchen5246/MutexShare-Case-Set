create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.166 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.315 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.091 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.327 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.253 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.073 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.316 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.137 -clock vclk [get_ports sel_4[2]]
