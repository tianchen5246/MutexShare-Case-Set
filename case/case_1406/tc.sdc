create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.268 -clock vclk [get_ports sel_1]
set_input_delay 0.148 -clock vclk [get_ports sel_2]
set_input_delay 0.301 -clock vclk [get_ports sel_3]
set_input_delay 0.31 -clock vclk [get_ports sel_4]
set_input_delay 0.316 -clock vclk [get_ports sel_5]
set_input_delay 0.118 -clock vclk [get_ports sel_6]
set_input_delay 0.255 -clock vclk [get_ports sel_7]
set_input_delay 0.196 -clock vclk [get_ports sel_8]
set_input_delay 0.227 -clock vclk [get_ports sel_9]
set_input_delay 0.279 -clock vclk [get_ports sel_10]
set_input_delay 0.245 -clock vclk [get_ports sel_11]
set_input_delay 0.187 -clock vclk [get_ports sel_12]
