create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.103 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.103 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.095 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.101 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.099 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.103 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.112 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.102 -clock vclk [get_ports sel_3[2]]
