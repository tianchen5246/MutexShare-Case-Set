create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.063 -clock vclk [get_ports sel_1]
set_input_delay 0.115 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.13 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.067 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.044 -clock vclk [get_ports sel_3]
set_input_delay 0.052 -clock vclk [get_ports sel_4]
set_input_delay 0.037 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.041 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.059 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.058 -clock vclk [get_ports sel_6]
set_input_delay 0.043 -clock vclk [get_ports sel_7]
set_input_delay 0.098 -clock vclk [get_ports sel_8]
set_input_delay 0.116 -clock vclk [get_ports sel_9]
set_input_delay 0.069 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.132 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.096 -clock vclk [get_ports sel_11]
set_input_delay 0.045 -clock vclk [get_ports sel_12[0]]
set_input_delay 0.089 -clock vclk [get_ports sel_12[1]]
