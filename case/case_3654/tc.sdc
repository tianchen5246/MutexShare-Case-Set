create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.168 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.17 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.159 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.171 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.174 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.17 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.176 -clock vclk [get_ports sel_4]
set_input_delay 0.172 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.171 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.162 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.167 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.16 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.161 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.169 -clock vclk [get_ports sel_7]
