create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.261 -clock vclk [get_ports sel_1]
set_input_delay 0.171 -clock vclk [get_ports sel_2]
set_input_delay 0.153 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.118 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.121 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.169 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.114 -clock vclk [get_ports sel_5]
set_input_delay 0.14 -clock vclk [get_ports sel_6]
set_input_delay 0.107 -clock vclk [get_ports sel_7]
set_input_delay 0.133 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.128 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.113 -clock vclk [get_ports sel_9]
set_input_delay 0.164 -clock vclk [get_ports sel_10]
