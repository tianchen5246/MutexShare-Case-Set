create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.127 -clock vclk [get_ports sel_1]
set_input_delay 0.118 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.126 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.121 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.119 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.133 -clock vclk [get_ports sel_4]
set_input_delay 0.118 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.121 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.117 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.129 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.127 -clock vclk [get_ports sel_6[1]]
