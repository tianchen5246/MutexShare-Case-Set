create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.248 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.205 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.258 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.244 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.246 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.225 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.204 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.25 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.213 -clock vclk [get_ports sel_5[1]]
