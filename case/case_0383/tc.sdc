create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.236 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.169 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.174 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.269 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.133 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.329 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.253 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.166 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.163 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.271 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.178 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.32 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.156 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.141 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.138 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_8[1]]
