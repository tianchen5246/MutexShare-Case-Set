set_input_delay 0.306 -clock vclk [get_ports sel_5]
set_input_delay 0.284 -clock vclk [get_ports sel_6]
set_input_delay 0.242 -clock vclk [get_ports sel_7]
set_input_delay 0.307 -clock vclk [get_ports sel_8]
set_input_delay 0.253 -clock vclk [get_ports sel_9]
set_input_delay 0.218 -clock vclk [get_ports sel_10]
set_input_delay 0.263 -clock vclk [get_ports sel_11]
set_input_delay 0.274 -clock vclk [get_ports sel_12]
set_input_delay 0.326 -clock vclk [get_ports sel_13]
