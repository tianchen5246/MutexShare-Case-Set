create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.346 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.316 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.312 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.264 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.286 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.28 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.306 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.281 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.274 -clock vclk [get_ports sel_3[2]]
