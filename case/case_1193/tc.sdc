create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.376 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.346 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.309 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.316 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.368 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.307 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.306 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.348 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.324 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.313 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.324 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.357 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.362 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.349 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.379 -clock vclk [get_ports sel_5[2]]
