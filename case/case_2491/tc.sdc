create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.103 -clock vclk [get_ports sel_1]
set_input_delay 0.363 -clock vclk [get_ports sel_2]
set_input_delay 0.125 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.343 -clock vclk [get_ports sel_4]
set_input_delay 0.256 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.271 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.284 -clock vclk [get_ports sel_6]
