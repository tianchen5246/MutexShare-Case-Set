create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.267 -clock vclk [get_ports sel_1]
set_input_delay 0.337 -clock vclk [get_ports sel_2]
set_input_delay 0.298 -clock vclk [get_ports sel_3]
set_input_delay 0.379 -clock vclk [get_ports sel_4]
set_input_delay 0.35 -clock vclk [get_ports sel_5]
set_input_delay 0.314 -clock vclk [get_ports sel_6]
set_input_delay 0.249 -clock vclk [get_ports sel_7]
set_input_delay 0.217 -clock vclk [get_ports sel_8]
set_input_delay 0.27 -clock vclk [get_ports sel_9]
set_input_delay 0.196 -clock vclk [get_ports sel_10]
set_input_delay 0.269 -clock vclk [get_ports sel_11]
set_input_delay 0.378 -clock vclk [get_ports sel_12]
