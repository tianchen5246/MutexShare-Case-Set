create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.229 -clock vclk [get_ports sel_1]
set_input_delay 0.309 -clock vclk [get_ports sel_2]
set_input_delay 0.369 -clock vclk [get_ports sel_3]
set_input_delay 0.377 -clock vclk [get_ports sel_4]
set_input_delay 0.32 -clock vclk [get_ports sel_5]
set_input_delay 0.252 -clock vclk [get_ports sel_6]
set_input_delay 0.211 -clock vclk [get_ports sel_7]
set_input_delay 0.341 -clock vclk [get_ports sel_8]
set_input_delay 0.348 -clock vclk [get_ports sel_9]
set_input_delay 0.352 -clock vclk [get_ports sel_10]
set_input_delay 0.312 -clock vclk [get_ports sel_11]
