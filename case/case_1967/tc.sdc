create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.349 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.214 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.312 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.353 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.251 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.255 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.285 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.288 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.367 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.228 -clock vclk [get_ports sel_4[2]]
