create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.189 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.38 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.296 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.316 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.39 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.29 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.359 -clock vclk [get_ports sel_3]
