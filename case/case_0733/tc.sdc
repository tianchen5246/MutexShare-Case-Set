create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.174 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.186 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.17 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.178 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.225 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.224 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.159 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.207 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.214 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.164 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.2 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.216 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.198 -clock vclk [get_ports sel_5[2]]
