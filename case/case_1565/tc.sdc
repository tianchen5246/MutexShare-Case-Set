create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.284 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.164 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.172 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.239 -clock vclk [get_ports sel_3]
set_input_delay 0.178 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.146 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.15 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.263 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.174 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.251 -clock vclk [get_ports sel_7]
set_input_delay 0.089 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.101 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_8[2]]
