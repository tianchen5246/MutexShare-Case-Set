create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.256 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.128 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.204 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.116 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.179 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.217 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.125 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.243 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.136 -clock vclk [get_ports sel_5[1]]
