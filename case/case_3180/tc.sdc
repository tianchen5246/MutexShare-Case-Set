create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.258 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.269 -clock vclk [get_ports sel_1[2]]
