create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.221 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.3 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.294 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.162 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.352 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.115 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.34 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.115 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.073 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.203 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.332 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.231 -clock vclk [get_ports sel_5[1]]
