create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.099 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.145 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.118 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.208 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.121 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.23 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.232 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.111 -clock vclk [get_ports sel_3[2]]
