create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.081 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.047 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.051 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.104 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.094 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.052 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.069 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.075 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.073 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.054 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.035 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.078 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.062 -clock vclk [get_ports sel_7]
set_input_delay 0.054 -clock vclk [get_ports sel_8]
set_input_delay 0.057 -clock vclk [get_ports sel_9]
set_input_delay 0.1 -clock vclk [get_ports sel_10]
set_input_delay 0.052 -clock vclk [get_ports sel_11]
