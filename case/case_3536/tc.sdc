create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.275 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.244 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.257 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.276 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.267 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.239 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.231 -clock vclk [get_ports sel_3[2]]
