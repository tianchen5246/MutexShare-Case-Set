create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.228 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.313 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.181 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.195 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.099 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.265 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.204 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.248 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.265 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.287 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.14 -clock vclk [get_ports sel_6[1]]
