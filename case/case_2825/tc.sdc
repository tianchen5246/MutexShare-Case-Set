create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.201 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.251 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.176 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.165 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.135 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.333 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.195 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.244 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.33 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.218 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.136 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.147 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.2 -clock vclk [get_ports sel_6[1]]
