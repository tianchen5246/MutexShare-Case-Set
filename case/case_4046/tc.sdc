create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.219 -clock vclk [get_ports sel_1]
set_input_delay 0.277 -clock vclk [get_ports sel_2]
set_input_delay 0.264 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.273 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.289 -clock vclk [get_ports sel_4]
set_input_delay 0.244 -clock vclk [get_ports sel_5]
set_input_delay 0.257 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.274 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.25 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.224 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_8]
set_input_delay 0.286 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.236 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.288 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.272 -clock vclk [get_ports sel_10[1]]
