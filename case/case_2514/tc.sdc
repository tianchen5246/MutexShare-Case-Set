set_input_delay 0.058 -clock vclk [get_ports sel_5]
set_input_delay 0.051 -clock vclk [get_ports sel_6]
set_input_delay 0.06 -clock vclk [get_ports sel_7]
set_input_delay 0.056 -clock vclk [get_ports sel_8]
set_input_delay 0.058 -clock vclk [get_ports sel_9]
set_input_delay 0.066 -clock vclk [get_ports sel_10]
set_input_delay 0.063 -clock vclk [get_ports sel_11]
set_input_delay 0.071 -clock vclk [get_ports sel_12]
set_input_delay 0.055 -clock vclk [get_ports sel_13]
set_input_delay 0.053 -clock vclk [get_ports sel_14]
