create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.182 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.148 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.136 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.189 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.158 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.202 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.168 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.193 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.201 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.134 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.111 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.107 -clock vclk [get_ports sel_7[1]]
