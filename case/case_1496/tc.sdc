create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.309 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.311 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.214 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.215 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.215 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.266 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.197 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.335 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.189 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.213 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.274 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.238 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.339 -clock vclk [get_ports sel_8[1]]
