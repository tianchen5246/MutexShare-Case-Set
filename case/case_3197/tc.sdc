create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.338 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.285 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.32 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.27 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.34 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.268 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.28 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.276 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.288 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.283 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.285 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.336 -clock vclk [get_ports sel_4[2]]
