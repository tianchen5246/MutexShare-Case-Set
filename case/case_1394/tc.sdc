set_input_delay 0.272 -clock vclk [get_ports sel_7]
set_input_delay 0.299 -clock vclk [get_ports sel_8]
set_input_delay 0.229 -clock vclk [get_ports sel_9]
set_input_delay 0.264 -clock vclk [get_ports sel_10]
set_input_delay 0.284 -clock vclk [get_ports sel_11]
