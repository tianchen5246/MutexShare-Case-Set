create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.296 -clock vclk [get_ports sel_1]
set_input_delay 0.151 -clock vclk [get_ports sel_2]
set_input_delay 0.215 -clock vclk [get_ports sel_3]
set_input_delay 0.139 -clock vclk [get_ports sel_4]
set_input_delay 0.167 -clock vclk [get_ports sel_5]
set_input_delay 0.299 -clock vclk [get_ports sel_6]
set_input_delay 0.276 -clock vclk [get_ports sel_7]
set_input_delay 0.282 -clock vclk [get_ports sel_8]
set_input_delay 0.213 -clock vclk [get_ports sel_9]
set_input_delay 0.138 -clock vclk [get_ports sel_10]
set_input_delay 0.15 -clock vclk [get_ports sel_11]
set_input_delay 0.24 -clock vclk [get_ports sel_12]
