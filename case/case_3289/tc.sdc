create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.356 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.342 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.283 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.315 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.309 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.345 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.292 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.317 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.363 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.296 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.295 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.313 -clock vclk [get_ports sel_5[2]]
