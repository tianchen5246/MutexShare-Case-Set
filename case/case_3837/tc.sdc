create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.313 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.165 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.234 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.188 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.298 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.211 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.305 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.256 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.202 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.178 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.255 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.307 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.195 -clock vclk [get_ports sel_8[1]]
