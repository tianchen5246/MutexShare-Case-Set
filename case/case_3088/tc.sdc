create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.314 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.321 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.163 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.337 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.337 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.213 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.242 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.323 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.219 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.241 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.28 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.274 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.129 -clock vclk [get_ports sel_5[2]]
