set_input_delay 0.319 -clock vclk [get_ports sel_8]
set_input_delay 0.315 -clock vclk [get_ports sel_9]
set_input_delay 0.183 -clock vclk [get_ports sel_10]
set_input_delay 0.222 -clock vclk [get_ports sel_11]
