create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.17 -clock vclk [get_ports sel_1]
set_input_delay 0.098 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.101 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.123 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.115 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.175 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.182 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.101 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.098 -clock vclk [get_ports sel_5]
set_input_delay 0.163 -clock vclk [get_ports sel_6]
set_input_delay 0.099 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.1 -clock vclk [get_ports sel_7[1]]
