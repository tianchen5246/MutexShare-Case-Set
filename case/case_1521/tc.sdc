create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.149 -clock vclk [get_ports sel_1]
set_input_delay 0.101 -clock vclk [get_ports sel_2]
set_input_delay 0.116 -clock vclk [get_ports sel_3]
set_input_delay 0.084 -clock vclk [get_ports sel_4]
set_input_delay 0.076 -clock vclk [get_ports sel_5]
set_input_delay 0.088 -clock vclk [get_ports sel_6]
set_input_delay 0.115 -clock vclk [get_ports sel_7]
