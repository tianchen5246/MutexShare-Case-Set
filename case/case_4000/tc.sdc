create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.075 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.077 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.076 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.094 -clock vclk [get_ports sel_2]
set_input_delay 0.097 -clock vclk [get_ports sel_3]
set_input_delay 0.08 -clock vclk [get_ports sel_4]
set_input_delay 0.088 -clock vclk [get_ports sel_5]
set_input_delay 0.09 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.084 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.099 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.107 -clock vclk [get_ports sel_7[1]]
