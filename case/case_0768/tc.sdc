create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.29 -clock vclk [get_ports sel_1]
set_input_delay 0.314 -clock vclk [get_ports sel_2]
set_input_delay 0.301 -clock vclk [get_ports sel_3]
set_input_delay 0.304 -clock vclk [get_ports sel_4]
set_input_delay 0.289 -clock vclk [get_ports sel_5]
set_input_delay 0.312 -clock vclk [get_ports sel_6]
set_input_delay 0.294 -clock vclk [get_ports sel_7]
set_input_delay 0.321 -clock vclk [get_ports sel_8]
set_input_delay 0.301 -clock vclk [get_ports sel_9]
