set_input_delay 0.144 -clock vclk [get_ports sel_5]
set_input_delay 0.135 -clock vclk [get_ports sel_6]
set_input_delay 0.088 -clock vclk [get_ports sel_7]
set_input_delay 0.16 -clock vclk [get_ports sel_8]
set_input_delay 0.097 -clock vclk [get_ports sel_9]
set_input_delay 0.082 -clock vclk [get_ports sel_10]
set_input_delay 0.091 -clock vclk [get_ports sel_11]
set_input_delay 0.076 -clock vclk [get_ports sel_12]
set_input_delay 0.098 -clock vclk [get_ports sel_13]
set_input_delay 0.079 -clock vclk [get_ports sel_14]
