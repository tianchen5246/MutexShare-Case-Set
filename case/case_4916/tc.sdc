create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.204 -clock vclk [get_ports sel_1]
set_input_delay 0.113 -clock vclk [get_ports sel_2]
set_input_delay 0.363 -clock vclk [get_ports sel_3]
set_input_delay 0.366 -clock vclk [get_ports sel_4]
set_input_delay 0.148 -clock vclk [get_ports sel_5]
set_input_delay 0.139 -clock vclk [get_ports sel_6]
set_input_delay 0.328 -clock vclk [get_ports sel_7]
set_input_delay 0.218 -clock vclk [get_ports sel_8]
set_input_delay 0.38 -clock vclk [get_ports sel_9]
set_input_delay 0.16 -clock vclk [get_ports sel_10]
set_input_delay 0.116 -clock vclk [get_ports sel_11]
set_input_delay 0.271 -clock vclk [get_ports sel_12]
