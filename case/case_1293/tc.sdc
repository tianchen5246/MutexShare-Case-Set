create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.265 -clock vclk [get_ports sel_1]
set_input_delay 0.232 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.229 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.248 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.304 -clock vclk [get_ports sel_3]
set_input_delay 0.133 -clock vclk [get_ports sel_4]
set_input_delay 0.184 -clock vclk [get_ports sel_5]
set_input_delay 0.145 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.081 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.067 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.171 -clock vclk [get_ports sel_8]
set_input_delay 0.137 -clock vclk [get_ports sel_9]
set_input_delay 0.275 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.105 -clock vclk [get_ports sel_10[1]]
