create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.17 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.206 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.233 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.198 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.241 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.223 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.174 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.182 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.254 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.265 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.21 -clock vclk [get_ports sel_4[2]]
