create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.189 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.179 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.273 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.263 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.149 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.178 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.161 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.271 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.173 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.163 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.151 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.246 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.257 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.18 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.235 -clock vclk [get_ports sel_7[1]]
