create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.253 -clock vclk [get_ports sel_1]
set_input_delay 0.326 -clock vclk [get_ports sel_2]
set_input_delay 0.328 -clock vclk [get_ports sel_3]
set_input_delay 0.367 -clock vclk [get_ports sel_4]
set_input_delay 0.26 -clock vclk [get_ports sel_5]
set_input_delay 0.23 -clock vclk [get_ports sel_6]
set_input_delay 0.266 -clock vclk [get_ports sel_7]
set_input_delay 0.282 -clock vclk [get_ports sel_8]
set_input_delay 0.226 -clock vclk [get_ports sel_9]
set_input_delay 0.324 -clock vclk [get_ports sel_10]
set_input_delay 0.368 -clock vclk [get_ports sel_11]
set_input_delay 0.351 -clock vclk [get_ports sel_12]
