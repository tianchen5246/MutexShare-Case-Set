create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.312 -clock vclk [get_ports sel_1]
set_input_delay 0.303 -clock vclk [get_ports sel_2]
set_input_delay 0.314 -clock vclk [get_ports sel_3]
set_input_delay 0.304 -clock vclk [get_ports sel_4]
set_input_delay 0.229 -clock vclk [get_ports sel_5]
set_input_delay 0.286 -clock vclk [get_ports sel_6]
set_input_delay 0.258 -clock vclk [get_ports sel_7]
set_input_delay 0.266 -clock vclk [get_ports sel_8]
set_input_delay 0.282 -clock vclk [get_ports sel_9]
set_input_delay 0.246 -clock vclk [get_ports sel_10]
set_input_delay 0.284 -clock vclk [get_ports sel_11]
set_input_delay 0.302 -clock vclk [get_ports sel_12]
