create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.053 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.021 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.025 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.016 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.013 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.051 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.033 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.04 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.019 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.036 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.048 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.028 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.037 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.011 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.052 -clock vclk [get_ports sel_7[1]]
