create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.165 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.117 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.249 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.187 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.199 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.229 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.159 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.261 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.153 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.232 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.167 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.123 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.283 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.116 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.158 -clock vclk [get_ports sel_5[2]]
