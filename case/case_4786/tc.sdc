set_input_delay 0.038 -clock vclk [get_ports sel_6]
set_input_delay 0.066 -clock vclk [get_ports sel_7]
set_input_delay 0.121 -clock vclk [get_ports sel_8]
set_input_delay 0.273 -clock vclk [get_ports sel_9]
set_input_delay 0.103 -clock vclk [get_ports sel_10]
set_input_delay 0.304 -clock vclk [get_ports sel_11]
set_input_delay 0.324 -clock vclk [get_ports sel_12]
