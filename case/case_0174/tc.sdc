create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.165 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.191 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.24 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.113 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.202 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.184 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.158 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.261 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.144 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.151 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.255 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.178 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.135 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.228 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.179 -clock vclk [get_ports sel_5[2]]
