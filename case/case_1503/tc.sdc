create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.223 -clock vclk [get_ports sel_1]
set_input_delay 0.179 -clock vclk [get_ports sel_2]
set_input_delay 0.05 -clock vclk [get_ports sel_3]
set_input_delay 0.183 -clock vclk [get_ports sel_4]
set_input_delay 0.14 -clock vclk [get_ports sel_5]
set_input_delay 0.091 -clock vclk [get_ports sel_6]
set_input_delay 0.039 -clock vclk [get_ports sel_7]
set_input_delay 0.211 -clock vclk [get_ports sel_8]
set_input_delay 0.113 -clock vclk [get_ports sel_9]
set_input_delay 0.02 -clock vclk [get_ports sel_10]
set_input_delay 0.106 -clock vclk [get_ports sel_11]
set_input_delay 0.187 -clock vclk [get_ports sel_12]
