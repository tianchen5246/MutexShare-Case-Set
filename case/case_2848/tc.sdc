create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.167 -clock vclk [get_ports sel_1]
set_input_delay 0.332 -clock vclk [get_ports sel_2]
set_input_delay 0.259 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.294 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.296 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.38 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.198 -clock vclk [get_ports sel_5]
set_input_delay 0.336 -clock vclk [get_ports sel_6]
set_input_delay 0.22 -clock vclk [get_ports sel_7]
set_input_delay 0.303 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.13 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.347 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.343 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.283 -clock vclk [get_ports sel_10]
set_input_delay 0.255 -clock vclk [get_ports sel_11[0]]
set_input_delay 0.285 -clock vclk [get_ports sel_11[1]]
set_input_delay 0.241 -clock vclk [get_ports sel_12[0]]
set_input_delay 0.348 -clock vclk [get_ports sel_12[1]]
