create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.245 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.307 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.284 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.308 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.339 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.261 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.31 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.252 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.255 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.275 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.228 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.227 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.278 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.331 -clock vclk [get_ports sel_7[1]]
