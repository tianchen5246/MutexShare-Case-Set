create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.302 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.314 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.281 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.321 -clock vclk [get_ports sel_2]
set_input_delay 0.307 -clock vclk [get_ports sel_3]
set_input_delay 0.311 -clock vclk [get_ports sel_4]
set_input_delay 0.301 -clock vclk [get_ports sel_5]
set_input_delay 0.27 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.328 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.291 -clock vclk [get_ports sel_6[2]]
set_input_delay 0.319 -clock vclk [get_ports sel_7]
set_input_delay 0.27 -clock vclk [get_ports sel_8]
set_input_delay 0.313 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.296 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.318 -clock vclk [get_ports sel_9[2]]
set_input_delay 0.302 -clock vclk [get_ports sel_10]
