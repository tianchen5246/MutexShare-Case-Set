create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.219 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.176 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.179 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.184 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.2 -clock vclk [get_ports sel_3]
set_input_delay 0.193 -clock vclk [get_ports sel_4]
set_input_delay 0.18 -clock vclk [get_ports sel_5]
set_input_delay 0.187 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.227 -clock vclk [get_ports sel_6[2]]
