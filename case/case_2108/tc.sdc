create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.164 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.153 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.22 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.158 -clock vclk [get_ports sel_3]
set_input_delay 0.15 -clock vclk [get_ports sel_4]
set_input_delay 0.175 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.151 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.211 -clock vclk [get_ports sel_5[2]]
set_input_delay 0.178 -clock vclk [get_ports sel_6]
set_input_delay 0.241 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.175 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.238 -clock vclk [get_ports sel_7[2]]
