create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.115 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.178 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.117 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.121 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.133 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.121 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.146 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.138 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.14 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.131 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.144 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.157 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.171 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.145 -clock vclk [get_ports sel_5[2]]
