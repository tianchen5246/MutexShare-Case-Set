create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.233 -clock vclk [get_ports sel_1]
set_input_delay 0.312 -clock vclk [get_ports sel_2]
set_input_delay 0.244 -clock vclk [get_ports sel_3]
set_input_delay 0.174 -clock vclk [get_ports sel_4]
set_input_delay 0.302 -clock vclk [get_ports sel_5]
set_input_delay 0.308 -clock vclk [get_ports sel_6]
set_input_delay 0.22 -clock vclk [get_ports sel_7]
set_input_delay 0.344 -clock vclk [get_ports sel_8]
set_input_delay 0.177 -clock vclk [get_ports sel_9]
set_input_delay 0.228 -clock vclk [get_ports sel_10]
set_input_delay 0.367 -clock vclk [get_ports sel_11]
set_input_delay 0.242 -clock vclk [get_ports sel_12]
