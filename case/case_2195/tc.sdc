set_input_delay 0.242 -clock vclk [get_ports sel_7]
set_input_delay 0.129 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.352 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.339 -clock vclk [get_ports sel_9]
set_input_delay 0.235 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.354 -clock vclk [get_ports sel_10[1]]
