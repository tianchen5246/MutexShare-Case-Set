create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.241 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.264 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.268 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.249 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.191 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.251 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.262 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.263 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.232 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.247 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.198 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.266 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.266 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.192 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.262 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_8[1]]
