create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.141 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.095 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.168 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.353 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.28 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.073 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.295 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.075 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.079 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.122 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.293 -clock vclk [get_ports sel_4[1]]
