create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.132 -clock vclk [get_ports sel_1]
set_input_delay 0.06 -clock vclk [get_ports sel_2]
set_input_delay 0.214 -clock vclk [get_ports sel_3]
set_input_delay 0.231 -clock vclk [get_ports sel_4]
set_input_delay 0.164 -clock vclk [get_ports sel_5]
set_input_delay 0.131 -clock vclk [get_ports sel_6]
set_input_delay 0.044 -clock vclk [get_ports sel_7]
set_input_delay 0.092 -clock vclk [get_ports sel_8]
set_input_delay 0.064 -clock vclk [get_ports sel_9]
set_input_delay 0.237 -clock vclk [get_ports sel_10]
set_input_delay 0.178 -clock vclk [get_ports sel_11]
set_input_delay 0.233 -clock vclk [get_ports sel_12]
set_input_delay 0.089 -clock vclk [get_ports sel_13]
