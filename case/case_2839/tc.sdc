create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.304 -clock vclk [get_ports sel_1]
set_input_delay 0.295 -clock vclk [get_ports sel_2]
set_input_delay 0.289 -clock vclk [get_ports sel_3]
set_input_delay 0.355 -clock vclk [get_ports sel_4]
set_input_delay 0.312 -clock vclk [get_ports sel_5]
set_input_delay 0.374 -clock vclk [get_ports sel_6]
set_input_delay 0.306 -clock vclk [get_ports sel_7]
set_input_delay 0.326 -clock vclk [get_ports sel_8]
set_input_delay 0.344 -clock vclk [get_ports sel_9]
set_input_delay 0.3 -clock vclk [get_ports sel_10]
