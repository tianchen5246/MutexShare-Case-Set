create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.284 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.293 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.116 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.164 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.182 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.215 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.245 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.308 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.178 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.165 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.163 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.184 -clock vclk [get_ports sel_6[1]]
