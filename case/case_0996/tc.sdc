create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.29 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.073 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.338 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.162 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.211 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.111 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.267 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.087 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.25 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.173 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.078 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.261 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.076 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.068 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.33 -clock vclk [get_ports sel_5[2]]
