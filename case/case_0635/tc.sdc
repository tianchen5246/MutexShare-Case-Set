create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.358 -clock vclk [get_ports sel_1]
set_input_delay 0.378 -clock vclk [get_ports sel_2]
set_input_delay 0.336 -clock vclk [get_ports sel_3]
set_input_delay 0.348 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.366 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.357 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.346 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.362 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.377 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.345 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.369 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.341 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.385 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.363 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.384 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.344 -clock vclk [get_ports sel_10[0]]
set_input_delay 0.384 -clock vclk [get_ports sel_10[1]]
set_input_delay 0.38 -clock vclk [get_ports sel_11]
