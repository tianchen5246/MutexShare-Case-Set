create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.215 -clock vclk [get_ports sel_1]
set_input_delay 0.098 -clock vclk [get_ports sel_2]
set_input_delay 0.188 -clock vclk [get_ports sel_3]
set_input_delay 0.201 -clock vclk [get_ports sel_4]
set_input_delay 0.054 -clock vclk [get_ports sel_5]
set_input_delay 0.218 -clock vclk [get_ports sel_6]
set_input_delay 0.033 -clock vclk [get_ports sel_7]
set_input_delay 0.14 -clock vclk [get_ports sel_8]
set_input_delay 0.082 -clock vclk [get_ports sel_9]
set_input_delay 0.146 -clock vclk [get_ports sel_10]
