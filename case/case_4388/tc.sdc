set_input_delay 0.131 -clock vclk [get_ports sel_6]
set_input_delay 0.137 -clock vclk [get_ports sel_7]
set_input_delay 0.106 -clock vclk [get_ports sel_8]
set_input_delay 0.149 -clock vclk [get_ports sel_9]
set_input_delay 0.088 -clock vclk [get_ports sel_10]
set_input_delay 0.083 -clock vclk [get_ports sel_11]
set_input_delay 0.082 -clock vclk [get_ports sel_12]
set_input_delay 0.084 -clock vclk [get_ports sel_13]
set_input_delay 0.079 -clock vclk [get_ports sel_14]
