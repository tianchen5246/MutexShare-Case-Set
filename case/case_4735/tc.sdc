create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.21 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.208 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.056 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.021 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.227 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.281 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.017 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.057 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.18 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.008 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.09 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.063 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.017 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.308 -clock vclk [get_ports sel_7[1]]
