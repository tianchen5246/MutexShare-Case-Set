create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.237 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.324 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.251 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.195 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.227 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.235 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.147 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.159 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.228 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.337 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.29 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.241 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.134 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.339 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.159 -clock vclk [get_ports sel_7[1]]
