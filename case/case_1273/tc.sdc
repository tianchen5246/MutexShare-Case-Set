create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.305 -clock vclk [get_ports sel_1]
set_input_delay 0.304 -clock vclk [get_ports sel_2]
set_input_delay 0.316 -clock vclk [get_ports sel_3]
set_input_delay 0.299 -clock vclk [get_ports sel_4]
set_input_delay 0.311 -clock vclk [get_ports sel_5]
set_input_delay 0.315 -clock vclk [get_ports sel_6]
set_input_delay 0.322 -clock vclk [get_ports sel_7]
set_input_delay 0.319 -clock vclk [get_ports sel_8]
set_input_delay 0.316 -clock vclk [get_ports sel_9]
set_input_delay 0.321 -clock vclk [get_ports sel_10]
set_input_delay 0.332 -clock vclk [get_ports sel_11]
set_input_delay 0.327 -clock vclk [get_ports sel_12]
