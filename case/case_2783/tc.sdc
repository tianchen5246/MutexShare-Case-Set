create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.027 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.039 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.07 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.067 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.028 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.135 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.195 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.036 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.038 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.109 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.119 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.12 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.207 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.047 -clock vclk [get_ports sel_5[2]]
