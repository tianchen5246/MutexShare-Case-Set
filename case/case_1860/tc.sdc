create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.088 -clock vclk [get_ports sel_1]
set_input_delay 0.079 -clock vclk [get_ports sel_2]
set_input_delay 0.099 -clock vclk [get_ports sel_3]
set_input_delay 0.106 -clock vclk [get_ports sel_4]
set_input_delay 0.088 -clock vclk [get_ports sel_5]
set_input_delay 0.106 -clock vclk [get_ports sel_6]
set_input_delay 0.082 -clock vclk [get_ports sel_7]
