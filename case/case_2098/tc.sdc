create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.235 -clock vclk [get_ports sel_1]
set_input_delay 0.13 -clock vclk [get_ports sel_2]
set_input_delay 0.243 -clock vclk [get_ports sel_3]
set_input_delay 0.077 -clock vclk [get_ports sel_4]
set_input_delay 0.115 -clock vclk [get_ports sel_5]
set_input_delay 0.203 -clock vclk [get_ports sel_6]
set_input_delay 0.183 -clock vclk [get_ports sel_7]
set_input_delay 0.181 -clock vclk [get_ports sel_8]
set_input_delay 0.199 -clock vclk [get_ports sel_9]
