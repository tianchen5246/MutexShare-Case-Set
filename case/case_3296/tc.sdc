create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.066 -clock vclk [get_ports sel_1]
set_input_delay 0.062 -clock vclk [get_ports sel_2]
set_input_delay 0.132 -clock vclk [get_ports sel_3]
set_input_delay 0.091 -clock vclk [get_ports sel_4]
set_input_delay 0.128 -clock vclk [get_ports sel_5]
set_input_delay 0.1 -clock vclk [get_ports sel_6]
set_input_delay 0.092 -clock vclk [get_ports sel_7]
set_input_delay 0.132 -clock vclk [get_ports sel_8]
set_input_delay 0.136 -clock vclk [get_ports sel_9]
