create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.391 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.391 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.391 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.388 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.388 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.384 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.39 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.387 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.386 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.39 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.385 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.388 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.386 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.388 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.387 -clock vclk [get_ports sel_5[2]]
