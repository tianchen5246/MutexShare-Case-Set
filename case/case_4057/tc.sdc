create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.287 -clock vclk [get_ports sel_1]
set_input_delay 0.305 -clock vclk [get_ports sel_2]
set_input_delay 0.288 -clock vclk [get_ports sel_3]
set_input_delay 0.301 -clock vclk [get_ports sel_4]
set_input_delay 0.268 -clock vclk [get_ports sel_5]
set_input_delay 0.281 -clock vclk [get_ports sel_6]
set_input_delay 0.264 -clock vclk [get_ports sel_7]
set_input_delay 0.276 -clock vclk [get_ports sel_8]
set_input_delay 0.269 -clock vclk [get_ports sel_9]
set_input_delay 0.272 -clock vclk [get_ports sel_10]
set_input_delay 0.282 -clock vclk [get_ports sel_11]
set_input_delay 0.309 -clock vclk [get_ports sel_12]
