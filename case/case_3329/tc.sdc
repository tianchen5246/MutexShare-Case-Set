create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.206 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.209 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.214 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.231 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.228 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.208 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.193 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.192 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.194 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.226 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.211 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.23 -clock vclk [get_ports sel_7[1]]
