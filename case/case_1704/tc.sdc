set_input_delay 0.036 -clock vclk [get_ports sel_6]
set_input_delay 0.089 -clock vclk [get_ports sel_7]
set_input_delay 0.081 -clock vclk [get_ports sel_8]
set_input_delay 0.125 -clock vclk [get_ports sel_9]
set_input_delay 0.153 -clock vclk [get_ports sel_10]
set_input_delay 0.152 -clock vclk [get_ports sel_11]
set_input_delay 0.026 -clock vclk [get_ports sel_12]
set_input_delay 0.08 -clock vclk [get_ports sel_13]
set_input_delay 0.139 -clock vclk [get_ports sel_14]
