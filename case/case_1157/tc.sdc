create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.174 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.143 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.173 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.222 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.091 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.224 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.115 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.107 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.176 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.194 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.226 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.228 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.173 -clock vclk [get_ports sel_7[1]]
set_input_delay 0.105 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.13 -clock vclk [get_ports sel_8[1]]
