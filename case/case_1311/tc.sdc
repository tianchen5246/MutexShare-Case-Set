create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.202 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.177 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.203 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.214 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.174 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.186 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.185 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.187 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.212 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.233 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.229 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.216 -clock vclk [get_ports sel_6[1]]
set_input_delay 0.23 -clock vclk [get_ports sel_7[0]]
set_input_delay 0.244 -clock vclk [get_ports sel_7[1]]
