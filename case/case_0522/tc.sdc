create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.103 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.275 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.053 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.104 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.055 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.271 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.226 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.111 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.078 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.203 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.281 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.285 -clock vclk [get_ports sel_4[2]]
