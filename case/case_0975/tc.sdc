create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.322 -clock vclk [get_ports sel_1]
set_input_delay 0.302 -clock vclk [get_ports sel_2]
set_input_delay 0.292 -clock vclk [get_ports sel_3]
set_input_delay 0.221 -clock vclk [get_ports sel_4]
set_input_delay 0.272 -clock vclk [get_ports sel_5]
set_input_delay 0.268 -clock vclk [get_ports sel_6]
set_input_delay 0.226 -clock vclk [get_ports sel_7]
set_input_delay 0.306 -clock vclk [get_ports sel_8]
