create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.073 -clock vclk [get_ports sel_1]
set_input_delay 0.14 -clock vclk [get_ports sel_2]
set_input_delay 0.207 -clock vclk [get_ports sel_3]
set_input_delay 0.21 -clock vclk [get_ports sel_4]
set_input_delay 0.162 -clock vclk [get_ports sel_5]
set_input_delay 0.136 -clock vclk [get_ports sel_6]
set_input_delay 0.148 -clock vclk [get_ports sel_7]
set_input_delay 0.186 -clock vclk [get_ports sel_8]
set_input_delay 0.068 -clock vclk [get_ports sel_9]
set_input_delay 0.184 -clock vclk [get_ports sel_10]
set_input_delay 0.138 -clock vclk [get_ports sel_11]
