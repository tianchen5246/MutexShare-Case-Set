create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.207 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.25 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.138 -clock vclk [get_ports sel_2]
set_input_delay 0.136 -clock vclk [get_ports sel_3]
set_input_delay 0.135 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.193 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.274 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.237 -clock vclk [get_ports sel_5[1]]
