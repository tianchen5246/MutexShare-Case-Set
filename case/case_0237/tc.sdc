create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.157 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.276 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.135 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.218 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.276 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.3 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.272 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.288 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.27 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.145 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.301 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.11 -clock vclk [get_ports sel_6[1]]
