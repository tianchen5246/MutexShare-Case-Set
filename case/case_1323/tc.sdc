create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.159 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.156 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.154 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.156 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.154 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.154 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.16 -clock vclk [get_ports sel_3[2]]
set_input_delay 0.158 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.161 -clock vclk [get_ports sel_4[1]]
