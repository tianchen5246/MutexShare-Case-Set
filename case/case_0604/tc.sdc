create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.08 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.011 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.049 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.043 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.096 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.084 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.08 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.048 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.081 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.072 -clock vclk [get_ports sel_5[0]]
set_input_delay 0.094 -clock vclk [get_ports sel_5[1]]
set_input_delay 0.014 -clock vclk [get_ports sel_6[0]]
set_input_delay 0.006 -clock vclk [get_ports sel_6[1]]
