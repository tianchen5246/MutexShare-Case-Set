create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.073 -clock vclk [get_ports sel_1]
set_input_delay 0.083 -clock vclk [get_ports sel_2]
set_input_delay 0.09 -clock vclk [get_ports sel_3]
set_input_delay 0.05 -clock vclk [get_ports sel_4]
set_input_delay 0.021 -clock vclk [get_ports sel_5]
set_input_delay 0.033 -clock vclk [get_ports sel_6]
set_input_delay 0.105 -clock vclk [get_ports sel_7]
set_input_delay 0.096 -clock vclk [get_ports sel_8]
set_input_delay 0.062 -clock vclk [get_ports sel_9]
set_input_delay 0.086 -clock vclk [get_ports sel_10]
set_input_delay 0.142 -clock vclk [get_ports sel_11]
