create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.081 -clock vclk [get_ports sel_1]
set_input_delay 0.065 -clock vclk [get_ports sel_2]
set_input_delay 0.093 -clock vclk [get_ports sel_3]
set_input_delay 0.255 -clock vclk [get_ports sel_4[0]]
set_input_delay 0.133 -clock vclk [get_ports sel_4[1]]
set_input_delay 0.142 -clock vclk [get_ports sel_4[2]]
set_input_delay 0.097 -clock vclk [get_ports sel_5]
set_input_delay 0.239 -clock vclk [get_ports sel_6]
set_input_delay 0.127 -clock vclk [get_ports sel_7]
set_input_delay 0.199 -clock vclk [get_ports sel_8[0]]
set_input_delay 0.214 -clock vclk [get_ports sel_8[1]]
set_input_delay 0.219 -clock vclk [get_ports sel_9[0]]
set_input_delay 0.243 -clock vclk [get_ports sel_9[1]]
set_input_delay 0.267 -clock vclk [get_ports sel_10]
set_input_delay 0.206 -clock vclk [get_ports sel_11[0]]
set_input_delay 0.269 -clock vclk [get_ports sel_11[1]]
set_input_delay 0.232 -clock vclk [get_ports sel_12]
