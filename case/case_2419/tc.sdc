create_clock -name vclk -period 1.0
set_input_delay 0.2 -clock vclk [get_ports in*]
set_output_delay 0.2 -clock vclk [all_outputs]
set_input_delay 0.262 -clock vclk [get_ports sel_1[0]]
set_input_delay 0.234 -clock vclk [get_ports sel_1[1]]
set_input_delay 0.258 -clock vclk [get_ports sel_1[2]]
set_input_delay 0.237 -clock vclk [get_ports sel_2[0]]
set_input_delay 0.24 -clock vclk [get_ports sel_2[1]]
set_input_delay 0.233 -clock vclk [get_ports sel_2[2]]
set_input_delay 0.231 -clock vclk [get_ports sel_3[0]]
set_input_delay 0.255 -clock vclk [get_ports sel_3[1]]
set_input_delay 0.258 -clock vclk [get_ports sel_3[2]]
