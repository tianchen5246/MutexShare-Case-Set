set_input_delay 0.263 -clock vclk [get_ports sel_6]
set_input_delay 0.298 -clock vclk [get_ports sel_7]
set_input_delay 0.296 -clock vclk [get_ports sel_8]
set_input_delay 0.257 -clock vclk [get_ports sel_9]
set_input_delay 0.293 -clock vclk [get_ports sel_10]
set_input_delay 0.294 -clock vclk [get_ports sel_11]
set_input_delay 0.26 -clock vclk [get_ports sel_12]
set_input_delay 0.317 -clock vclk [get_ports sel_13]
set_input_delay 0.313 -clock vclk [get_ports sel_14]
